@{
    ViewData["Title"] = "Admin Panel";
}

<div class="admin-container">
    <!-- Gutschein erstellen Sektion -->
    <div class="admin-section voucher-create-section">
        <div class="admin-section-header">
            <h2>Neuen Gutschein erstellen</h2>
        </div>
        <form id="createVoucherForm" method="post" action="@Url.Action("CreateVoucher", "Admin")">
            @Html.AntiForgeryToken()
            
            <div class="admin-form-group">
                <label for="voucherDescription" class="admin-label">Bezeichnung</label>
                <input type="text" id="voucherDescription" name="description" class="admin-input" placeholder="z.B. 5€ Gutschein" required />
            </div>
            
            <div class="admin-form-group">
                <label for="voucherPrice" class="admin-label">Preis</label>
                <input type="number" id="voucherPrice" name="price" class="admin-input" placeholder="Preis in Punkten" min="1" required />
            </div>
            
            <div class="admin-form-group">
                <label for="voucherValidUntil" class="admin-label">Gültig bis:</label>
                <input type="date" id="voucherValidUntil" name="validUntil" class="admin-input" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            
            <button type="submit" class="admin-button primary-admin-button">
                <span>Neuen Gutschein erstellen</span>
            </button>
        </form>
    </div>
    
    <!-- Fahrten Statistik Sektion -->
    <div class="admin-section statistics-section">
        <div class="admin-section-header">
            <h2>Fahrten Statistik Gesamt</h2>
        </div>

        <div class="statistics-grid">
            <div class="stat-card">
                <div class="stat-label">Fahrten gesamt:</div>
                <div class="stat-value">@ViewBag.TotalRides</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Gesamt gefahrene Kilometer:</div>
                <div class="stat-value">@(ViewBag.TotalDistance)km</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Gesamt Anzahl Passagiere:</div>
                <div class="stat-value">@ViewBag.TotalPassengers</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Error"] != null)
            {
                <text>alert("@TempData["Error"]");</text>
            }
            @if (TempData["Success"] != null)
            {
                <text>alert("@TempData["Success"]");</text>
            }

        });

        
    </script>
}
