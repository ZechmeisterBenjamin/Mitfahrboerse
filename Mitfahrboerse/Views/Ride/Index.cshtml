@model IEnumerable<Mitfahrboerse.Models.t_Ride>
@{
    ViewData["Title"] = "Mitfahren";
    var firstRide = Model.FirstOrDefault();
}

<div class="filter-bar">
    <div id="filter-menu" class="fahrt-filter filter-menu">
        <input id="filter-driver" type="text" placeholder="Fahrer" />
        <input id="filter-class" type="text" placeholder="Klasse" />
        <input id="filter-from" type="text" placeholder="Von" />
        <input id="filter-to" type="text" placeholder="Nach" />
        <input id="filter-date" type="date" placeholder="Datum" />
        <input id="filter-time" type="time" placeholder="Zeit" />
        <button id="filter-reset" type="button" class="filter-reset-button">Zurücksetzen</button>
    </div>
</div>

<main style="display: flex; gap: 20px; padding: 20px;">
    <div class="left-column">
        <div class="rides-header">
            <h3>Verfügbare Fahrten</h3>
            <span class="rides-count" id="rides-count">@Model.Count() Fahrten</span>
        </div>
        <div class="rides-list-container">
            @foreach (var ride in Model)
            {
                var occupied = ride.PersonRides?.Count ?? 0;
                var capacity = ride.FK_Car != null ? ride.FK_Car.Seats : 0;
                var freeSeats = capacity - occupied;

                <div class="fahrt-item @(firstRide != null && firstRide.RideId == ride.RideId ? "selected" : "")"
                     data-ride-id="@ride.RideId"
                     data-driver-name="@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName"
                     data-driver-class="@ride.FK_Driver_Person.Class"
                     data-from="@ride.FK_StartsAt_Position.Description"
                     data-to="@ride.FK_EndsAt_Position.Description"
                     data-time="@ride.RideDateTime.ToString("HH:mm")"
                     data-date="@ride.RideDateTime.ToString("dd.MM.yyyy")"
                     data-date-iso="@ride.RideDateTime.ToString("yyyy-MM-dd")"
                     data-seats="@freeSeats"
                     data-car-license="@(ride.FK_Car.LicensePlate)">

                    <div class="fahrt-item-content">
                        <div class="fahrt-item-header">
                            <strong class="driver-name">@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName</strong>
                            <span class="seats-badge @(freeSeats > 0 ? "available" : "full")">
                                @freeSeats
                                @if (freeSeats == 1)
                                {
                                    <span>Platz</span>
                                }
                                else
                                {
                                    <span>Plätze</span>
                                }
                            </span>
                        </div>
                        <div class="fahrt-item-route">
                            <strong>@ride.FK_StartsAt_Position.Description</strong> → <strong>@ride.FK_EndsAt_Position.Description</strong>
                        </div>
                        <div class="fahrt-item-time">
                            @ride.RideDateTime.ToString("dd.MM.yyyy") | @ride.RideDateTime.ToString("HH:mm")
                        </div>
                    </div>
                </div>
            }
            <div id="no-rides-message" class="no-rides-message" style="display: none;">
                <div class="empty-state">
                    <p>Keine Fahrten gefunden</p>
                    <small>Versuchen Sie, die Filter anzupassen</small>
                </div>
            </div>
        </div>
    </div>

    <div class="right-column">
        @if (firstRide != null)
        {
            var firstFreeSeats = (firstRide.FK_Car?.Seats ?? 0) - (firstRide.PersonRides?.Count ?? 0);

            <div id="ride-details" class="fahrt-details-compact">
                <h3 class="details-title">Fahrtdetails</h3>

                <div class="details-grid">
                    <div class="detail-item">
                        <span class="detail-label">Fahrer:</span>
                        <span id="driver-name" class="detail-value">@firstRide.FK_Driver_Person.FirstName @firstRide.FK_Driver_Person.LastName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Klasse:</span>
                        <span id="driver-class" class="detail-value">@firstRide.FK_Driver_Person.Class</span>
                    </div>
                    <div class="detail-item highlight-item">
                        <span class="detail-label">Freie Plätze:</span>
                        <span id="seats" class="detail-value seats-highlight">@firstFreeSeats</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Datum:</span>
                        <span id="date" class="detail-value">@firstRide.RideDateTime.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Zeit:</span>
                        <span id="time" class="detail-value">@firstRide.RideDateTime.ToString("HH:mm")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Fahrzeug:</span>
                        <span id="car-license" class="detail-value">@firstRide.FK_Car?.LicensePlate</span>
                    </div>
                    <div class="detail-item route-item">
                        <span class="detail-label">Strecke:</span>
                        <span id="route" class="detail-value route-value">
                            @firstRide.FK_StartsAt_Position.Description → @firstRide.FK_EndsAt_Position.Description
                        </span>
                    </div>
                </div>
            </div>
            <button class="anfrage-button" id="request-button">
                <span>Anfrage schicken</span>
            </button>
        }
        else
        {
            <div class="empty-state">
                <p>Keine Fahrten verfügbar</p>
                <small>Schauen Sie später wieder vorbei</small>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rideItems = document.querySelectorAll('.fahrt-item');
            const driverName = document.getElementById('driver-name');
            const driverClass = document.getElementById('driver-class');
            const seats = document.getElementById('seats');
            const route = document.getElementById('route');
            const time = document.getElementById('time');
            const date = document.getElementById('date');
            const carLicense = document.getElementById('car-license');
            const requestButton = document.getElementById('request-button');
            const ridesCount = document.getElementById('rides-count');
            const noRidesMessage = document.getElementById('no-rides-message');

            let selectedRideId = @(firstRide?.RideId ?? 0);

            const filterDriver = document.getElementById('filter-driver');
            const filterClass = document.getElementById('filter-class');
            const filterFrom = document.getElementById('filter-from');
            const filterTo = document.getElementById('filter-to');
            const filterDate = document.getElementById('filter-date');
            const filterTime = document.getElementById('filter-time');
            const filterReset = document.getElementById('filter-reset');

            rideItems.forEach(item => {
                item.addEventListener('click', function() {
                    rideItems.forEach(ri => ri.classList.remove('selected'));
                    this.classList.add('selected');

                    driverName.textContent = this.getAttribute('data-driver-name');
                    driverClass.textContent = this.getAttribute('data-driver-class');
                    const seatCount = this.getAttribute('data-seats');
                    seats.textContent = seatCount;
                    seats.className = 'detail-value seats-highlight';
                    if (parseInt(seatCount) === 0) {
                        seats.classList.add('no-seats');
                    }
                    route.textContent = `${this.getAttribute('data-from')} → ${this.getAttribute('data-to')}`;
                    time.textContent = this.getAttribute('data-time');
                    date.textContent = this.getAttribute('data-date');
                    carLicense.textContent = this.getAttribute('data-car-license');
                    selectedRideId = parseInt(this.getAttribute('data-ride-id'));
                });
            });

            function updateRidesCount() {
                const visibleRides = Array.from(rideItems).filter(item => !item.classList.contains('hidden'));
                const count = visibleRides.length;
                if (ridesCount) {
                    ridesCount.textContent = count === 1 ? '1 Fahrt' : count + ' Fahrten';
                }

                if (noRidesMessage) {
                    noRidesMessage.style.display = count === 0 ? 'block' : 'none';
                }
            }

            function selectFirstVisibleRide() {
                const firstVisible = Array.from(rideItems).find(item => !item.classList.contains('hidden'));
                if (!firstVisible) {
                    if (requestButton) {
                        requestButton.disabled = true;
                        requestButton.style.opacity = '0.5';
                        requestButton.style.cursor = 'not-allowed';
                    }
                    return;
                }
                if (requestButton) {
                    requestButton.disabled = false;
                    requestButton.style.opacity = '1';
                    requestButton.style.cursor = 'pointer';
                }
                firstVisible.click();
            }

            function applyFilters() {
                const driverValue = (filterDriver.value || '').toLowerCase();
                const classValue = (filterClass.value || '').toLowerCase();
                const fromValue = (filterFrom.value || '').toLowerCase();
                const toValue = (filterTo.value || '').toLowerCase();
                const dateValue = filterDate.value || '';
                const timeValue = filterTime.value || '';

                rideItems.forEach(item => {
                    const itemDriver = (item.getAttribute('data-driver-name') || '').toLowerCase();
                    const itemClass = (item.getAttribute('data-driver-class') || '').toLowerCase();
                    const itemFrom = (item.getAttribute('data-from') || '').toLowerCase();
                    const itemTo = (item.getAttribute('data-to') || '').toLowerCase();
                    const itemDateIso = item.getAttribute('data-date-iso') || '';
                    const itemTime = item.getAttribute('data-time') || '';
                    const itemSeats = parseInt(item.getAttribute('data-seats') || '0');

                    const matchesDriver = !driverValue || itemDriver.includes(driverValue);
                    const matchesClass = !classValue || itemClass.includes(classValue);
                    const matchesFrom = !fromValue || itemFrom.includes(fromValue);
                    const matchesTo = !toValue || itemTo.includes(toValue);
                    const matchesDate = !dateValue || itemDateIso === dateValue;
                    const matchesTime = !timeValue || itemTime === timeValue;
                    const matchesSeats = itemSeats >= 1;

                    const isMatch = matchesDriver && matchesClass && matchesFrom && matchesTo && matchesDate && matchesTime && matchesSeats;
                    item.classList.toggle('hidden', !isMatch);
                });

                const selected = document.querySelector('.fahrt-item.selected');
                const anyVisible = Array.from(rideItems).some(item => !item.classList.contains('hidden'));
                if (!anyVisible || !selected || selected.classList.contains('hidden')) {
                    selectFirstVisibleRide();
                }

                updateRidesCount();
            }

            [filterDriver, filterClass, filterFrom, filterTo, filterDate, filterTime].forEach(input => {
                input.addEventListener('input', applyFilters);
                input.addEventListener('change', applyFilters);
            });

            filterReset.addEventListener('click', function() {
                filterDriver.value = '';
                filterClass.value = '';
                filterFrom.value = '';
                filterTo.value = '';
                filterDate.value = '';
                filterTime.value = '';
                applyFilters();
            });

            if (requestButton) {
                requestButton.addEventListener('click', function() {
                    if (selectedRideId && !this.disabled) {
                        this.disabled = true;
                        this.innerHTML = '<span>Wird gesendet...</span>';

                        fetch('@Url.Action("RequestRide", "Ride")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: `rideId=${selectedRideId}`
                        })
                        .then(response => response.json())
                        .then(data => {
                            if(data.success) {
                                alert(data.message);
                                location.reload();
                            } else {
                                alert("Fehler: " + data.message);
                                requestButton.disabled = false;
                                requestButton.innerHTML = '<span>Anfrage schicken</span>';
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.');
                            requestButton.disabled = false;
                            requestButton.innerHTML = '<span>Anfrage schicken</span>';
                        });
                    }
                });
            }

            updateRidesCount();
            applyFilters();
        });
    </script>
}