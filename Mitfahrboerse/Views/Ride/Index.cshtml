@model IEnumerable<Mitfahrboerse.Models.t_Ride>
@{
    int coinBalance = 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <title>HTL Waidhofen - Mitfahren</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #a5a5a5;
            overflow: hidden;
        }

        header {
            background-color: #cfe2ff;
            display: flex;
            align-items: center;
            padding: 10px 30px;
        }

        .logo img {
            height: 90px;
            margin-right: 10px;
        }

        .menu {
            display: flex;
            gap: 30px;
            align-items: center;
            margin-left: 30px;
        }

        .menu-item {
            text-align: center;
            cursor: pointer;
        }

        .menu-item span {
            display: block;
        }

        .coin-balance {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

        .coin-balance img {
            height: 50px;
        }

        main {
            display: flex;
            padding: 20px;
            gap: 20px;
            height: calc(100vh - 110px);
            box-sizing: border-box;
        }

        .left-column {
            flex: 1;
            background-color: #666;
            border-radius: 15px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .fahrt-item {
            background-color: #4d4d4d;
            border-radius: 15px;
            padding: 10px;
            text-align: center;
            color: white;
        }

        .right-column {
            flex: 2;
            background-color: #4d4d4d;
            border-radius: 15px;
            padding: 20px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .fahrt-details {
            display: flex;
            justify-content: space-between;
        }

        .anfrage-button {
            background-color: transparent;
            border: 2px solid white;
            color: white;
            border-radius: 20px;
            padding: 10px 20px;
            cursor: pointer;
            align-self: flex-start;
        }
    </style>
</head>
<body>
<main>
    <div class="left-column">
        @foreach (var ride in Model)
        {
            <div class="fahrt-item">
                <strong>@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName</strong><br>
                @ride.FK_StartsAt_Position.Description- @ride.FK_EndsAt_Position.Description<br>
                @ride.RideDateTime
            </div>
        }
    </div>

    <div class="right-column">
        <div>
            <div class="fahrt-details">
                <span>Name</span>
                <span>Klasse</span>
                <span>Plätze</span>
            </div>
            <div class="fahrt-details">
                <span>Von - Nach</span>
                <span>Um</span>
                <span>Wann</span>
            </div>
            <div>
                [Kennzeichen des Autos]
            </div>
        </div>
        <button class="anfrage-button">Anfrage schicken</button>
    </div>
</main>
</body>
</html>
