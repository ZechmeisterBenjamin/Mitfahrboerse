@model IEnumerable<Mitfahrboerse.Models.t_Ride>
@{
    ViewData["Title"] = "Mitfahren";
    var firstRide = Model.FirstOrDefault();
    var matchingRidesDict = ViewBag.MatchingRidesDict as Dictionary<int, Mitfahrboerse.Services.RideWithDetourInfo>;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<div class="filter-bar" style="display: flex; flex-direction: column; align-items: stretch;">
    <div id="filter-menu" class="fahrt-filter filter-menu" style="display: flex; flex-wrap: wrap; width: 100%; gap: 10px; justify-content: flex-start; padding: 0;">

        <input id="searchStart" type="text" placeholder="Route: Von (z.B. Ybbsitz)" style="flex: 1; min-width: 180px;" />
        <input id="searchEnd" type="text" placeholder="Route: Nach (z.B. Waidhofen)" style="flex: 1; min-width: 180px;" />
        <button id="searchBtn" type="button" class="styled-button primary-button" style="margin: 0; padding: 0 20px; height: 48px; flex-shrink: 0;">Suchen</button>

        <div style="width: 100%; height: 2px; background: #7a7a7a; margin: 5px 0; border-radius: 2px;"></div>

        <input id="filter-from" type="text" placeholder="Start (Text)" style="flex: 1; min-width: 130px;" />
        <input id="filter-to" type="text" placeholder="Ziel (Text)" style="flex: 1; min-width: 130px;" />
        <input id="filter-driver" type="text" placeholder="Fahrer" style="flex: 1; min-width: 130px;" />
        <input id="filter-class" type="text" placeholder="Klasse" style="flex: 1; min-width: 100px;" />
        <input id="filter-date" type="date" placeholder="Datum" style="flex: 1; min-width: 140px;" />
        <input id="filter-time" type="time" placeholder="Zeit" style="flex: 1; min-width: 110px;" />
        <button id="filter-reset" type="button" class="filter-reset-button" style="margin: 0; padding: 0 20px; height: 48px; flex-shrink: 0;">Filter löschen</button>

    </div>
</div>

<main style="display: flex; gap: 20px; padding: 20px;">
    <div class="left-column">
        <div class="rides-header">
            <h3>Verfügbare Fahrten</h3>
            <span class="rides-count" id="rides-count">@Model.Count() Fahrten</span>
        </div>
        <div class="rides-list-container">
            @foreach (var ride in Model)
            {
                var occupied = ride.PersonRides?.Count(pr => pr.Status == 0) ?? 0;
                var capacity = ride.FK_Car != null ? ride.FK_Car.Seats : 0;
                var freeSeats = capacity - occupied;

                <div class="fahrt-item @(firstRide != null && firstRide.RideId == ride.RideId ? "selected" : "")"
                     data-ride-id="@ride.RideId"
                     data-driver-name="@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName"
                     data-driver-class="@ride.FK_Driver_Person.Class"
                     data-from="@ride.FK_StartsAt_Position.Description"
                     data-to="@ride.FK_EndsAt_Position.Description"
                     data-time="@ride.RideDateTime.ToString("HH:mm")"
                     data-date="@ride.RideDateTime.ToString("dd.MM.yyyy")"
                     data-date-iso="@ride.RideDateTime.ToString("yyyy-MM-dd")"
                     data-seats="@freeSeats"
                     data-car-license="@(ride.FK_Car?.LicensePlate)">

                    <div class="fahrt-item-content">
                        <div class="fahrt-item-header">
                            <strong class="driver-name">@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName</strong>
                            <span class="seats-badge @(freeSeats > 0 ? "available" : "full")">
                                @freeSeats
                                @if (freeSeats == 1)
                                {
                                    <span>Platz</span>
                                }
                                else
                                {

                                    <span>Plätze</span>
                                }
                            </span>
                        </div>
                        <div class="fahrt-item-route" style="display: flex; align-items: center; gap: 8px; margin: 10px 0;">
                            <span style="font-weight: bold;">@ride.FK_StartsAt_Position.Description</span>
                            <div class="route-divider" style="flex-grow: 1; height: 1px; background: #7a7a7a; position: relative;">
                                <span style="position: absolute; right: -2px; top: -7px; font-size: 10px; color: #ffd60a;">▶</span>
                            </div>
                            <span style="font-weight: bold;">@ride.FK_EndsAt_Position.Description</span>
                        </div>
                        <div class="fahrt-item-time">
                            @ride.RideDateTime.ToString("dd.MM.yyyy") | @ride.RideDateTime.ToString("HH:mm")
                        </div>
                        @if (matchingRidesDict != null && matchingRidesDict.ContainsKey(ride.RideId))
                        {
                            var detourInfo = matchingRidesDict[ride.RideId];
                            <div class="fahrt-item-detour" style="margin-top: 8px; padding: 5px 10px; border: 1px dashed #ffd60a; color: #ffd60a; border-radius: 6px; display: inline-block; font-size: 12px; background: rgba(255, 214, 10, 0.1);">
                                📍 Umweg: @Math.Round(detourInfo.DetourKilometers, 1) km (@detourInfo.MatchType)
                            </div>
                        }
                    </div>
                </div>
            }
            <div id="no-rides-message" class="no-rides-message" style="display: none;">
                <div class="empty-state">
                    <p>Keine Fahrten gefunden</p>
                    <small>Versuchen Sie, die Filter anzupassen</small>
                </div>
            </div>
        </div>
    </div>

    <div class="right-column">
        @if (firstRide != null)
        {
            var firstFreeSeats = (firstRide.FK_Car?.Seats ?? 0) - (firstRide.PersonRides?.Count ?? 0);

            <div id="ride-details" class="fahrt-details-compact">
                <h3 class="details-title">Fahrtdetails</h3>
                <div class="details-grid">
                    <div class="detail-item">
                        <span class="detail-label">Fahrer:</span>
                        <span id="driver-name" class="detail-value">@firstRide.FK_Driver_Person.FirstName @firstRide.FK_Driver_Person.LastName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Klasse:</span>
                        <span id="driver-class" class="detail-value">@firstRide.FK_Driver_Person.Class</span>
                    </div>
                    <div class="detail-item highlight-item">
                        <span class="detail-label">Freie Plätze:</span>
                        <span id="seats" class="detail-value seats-highlight">@firstFreeSeats</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Datum:</span>
                        <span id="date" class="detail-value">@firstRide.RideDateTime.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Zeit:</span>
                        <span id="time" class="detail-value">@firstRide.RideDateTime.ToString("HH:mm")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Fahrzeug:</span>
                        <span id="car-license" class="detail-value">@firstRide.FK_Car?.LicensePlate</span>
                    </div>
                    <div class="detail-item route-item">
                        <span class="detail-label">Strecke:</span>
                        <span id="route" class="detail-value route-value">
                            @firstRide.FK_StartsAt_Position.Description → @firstRide.FK_EndsAt_Position.Description
                        </span>
                    </div>
                </div>
            </div>
            <button class="anfrage-button" id="request-button">
                <span>Anfrage schicken</span>
            </button>
        }
        else
        {
            <div class="empty-state">
                <p>Keine Fahrten verfügbar</p>
                <small>Schauen Sie später wieder vorbei</small>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let selectedRideId = @(firstRide?.RideId ?? 0);

            const filterDriver = document.getElementById('filter-driver');
            const filterClass = document.getElementById('filter-class');
            const filterFrom = document.getElementById('filter-from');
            const filterTo = document.getElementById('filter-to');
            const filterDate = document.getElementById('filter-date');
            const filterTime = document.getElementById('filter-time');
            const filterReset = document.getElementById('filter-reset');

            const searchStartInput = document.getElementById('searchStart');
            const searchEndInput = document.getElementById('searchEnd');
            const searchBtn = document.getElementById('searchBtn');
            const clearSearchBtn = document.getElementById('clearSearchBtn');

            // --- 1. KLASSISCHE FILTER LOGIK (Lokal) ---
            function applyFilters() {
                const driverValue = (filterDriver.value || '').toLowerCase();
                const classValue = (filterClass.value || '').toLowerCase();
                const fromValue = (filterFrom.value || '').toLowerCase();
                const toValue = (filterTo.value || '').toLowerCase();
                const dateValue = filterDate.value || '';
                const timeValue = filterTime.value || '';

                const rideItems = document.querySelectorAll('.fahrt-item');
                let visibleCount = 0;

                rideItems.forEach(item => {
                    const itemDriver = (item.getAttribute('data-driver-name') || '').toLowerCase();
                    const itemClass = (item.getAttribute('data-driver-class') || '').toLowerCase();
                    const itemFrom = (item.getAttribute('data-from') || '').toLowerCase();
                    const itemTo = (item.getAttribute('data-to') || '').toLowerCase();
                    const itemDateIso = item.getAttribute('data-date-iso') || '';
                    const itemTime = item.getAttribute('data-time') || '';
                    const itemSeats = parseInt(item.getAttribute('data-seats') || '0');

                    const isMatch = (!driverValue || itemDriver.includes(driverValue)) &&
                                    (!classValue || itemClass.includes(classValue)) &&
                                    (!fromValue || itemFrom.includes(fromValue)) &&
                                    (!toValue || itemTo.includes(toValue)) &&
                                    (!dateValue || itemDateIso === dateValue) &&
                                    (!timeValue || itemTime === timeValue) &&
                                    (itemSeats >= 1);

                    item.classList.toggle('hidden', !isMatch);
                    if (isMatch) visibleCount++;
                });

                const ridesCount = document.getElementById('rides-count');
                const noRidesMessage = document.getElementById('no-rides-message');
                if (ridesCount) ridesCount.textContent = visibleCount === 1 ? '1 Fahrt' : visibleCount + ' Fahrten';
                if (noRidesMessage) noRidesMessage.style.display = visibleCount === 0 ? 'block' : 'none';

                const selected = document.querySelector('.fahrt-item.selected');
                if (visibleCount > 0 && (!selected || selected.classList.contains('hidden'))) {
                    const firstVisible = Array.from(rideItems).find(item => !item.classList.contains('hidden'));
                    if (firstVisible) firstVisible.click();
                }
            }

            [filterDriver, filterClass, filterFrom, filterTo, filterDate, filterTime].forEach(input => {
                input.addEventListener('input', applyFilters);
                input.addEventListener('change', applyFilters);
            });

            // --- 2. MAIN BEREICH (KLICKS & ANFRAGEN) ---
            function rebindMainEvents() {
                const rideItems = document.querySelectorAll('.fahrt-item');
                const driverName = document.getElementById('driver-name');
                const driverClass = document.getElementById('driver-class');
                const seats = document.getElementById('seats');
                const route = document.getElementById('route');
                const time = document.getElementById('time');
                const date = document.getElementById('date');
                const carLicense = document.getElementById('car-license');
                const requestButton = document.getElementById('request-button');

                rideItems.forEach(item => {
                    item.addEventListener('click', function() {
                        rideItems.forEach(ri => ri.classList.remove('selected'));
                        this.classList.add('selected');

                        if(driverName) driverName.textContent = this.getAttribute('data-driver-name');
                        if(driverClass) driverClass.textContent = this.getAttribute('data-driver-class');
                        if(seats) {
                            const seatCount = this.getAttribute('data-seats');
                            seats.textContent = seatCount;
                            seats.className = 'detail-value seats-highlight';
                            if (parseInt(seatCount) === 0) seats.classList.add('no-seats');
                        }
                        if(route) route.textContent = `${this.getAttribute('data-from')} → ${this.getAttribute('data-to')}`;
                        if(time) time.textContent = this.getAttribute('data-time');
                        if(date) date.textContent = this.getAttribute('data-date');
                        if(carLicense) carLicense.textContent = this.getAttribute('data-car-license');

                        selectedRideId = parseInt(this.getAttribute('data-ride-id'));
                    });
                });

                if (requestButton) {
                    requestButton.addEventListener('click', function() {
                        if (selectedRideId && !this.disabled) {
                            this.disabled = true;
                            this.innerHTML = '<span>Wird gesendet...</span>';

                            fetch('@Url.Action("RequestRide", "Ride")', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body: `rideId=${selectedRideId}`
                            })
                            .then(response => response.json())
                            .then(data => {
                                if(data.success) {
                                    alert(data.message);
                                    fetchRidesWithoutReload();
                                } else {
                                    alert("Fehler: " + data.message);
                                    requestButton.disabled = false;
                                    requestButton.innerHTML = '<span>Anfrage schicken</span>';
                                }
                            })
                            .catch(error => {
                                alert('Ein Fehler ist aufgetreten.');
                                requestButton.disabled = false;
                                requestButton.innerHTML = '<span>Anfrage schicken</span>';
                            });
                        }
                    });
                }
            }

            // --- 3. AJAX SEITENLADEN (OHNE REFRESH) FÜR INTELLIGENTE SUCHE ---
            async function fetchRidesWithoutReload(url = window.location.href) {
                try {
                    const response = await fetch(url);
                    const html = await response.text();

                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    document.querySelector('main').innerHTML = doc.querySelector('main').innerHTML;
                    window.history.pushState({}, '', url);

                    rebindMainEvents();
                    applyFilters();

                } catch (error) {
                    console.error('AJAX Fehler:', error);
                    alert("Konnte Fahrten nicht aktualisieren.");
                }
            }

            // --- 4. INTELLIGENTE SUCHE (AJAX) ---
            async function geocodeAddress(address) {
                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&countrycodes=AT`;
                try {
                    const response = await fetch(url);
                    if (!response.ok) throw new Error('Netzwerkfehler');
                    const data = await response.json();
                    if (data && data.length > 0) return { lat: data[0].lat, lon: data[0].lon };
                } catch (e) {}
                return null;
            }

            searchBtn.addEventListener('click', async function() {
                const startInput = searchStartInput.value.trim();
                const endInput = searchEndInput.value.trim();

                if (!startInput || !endInput) {
                    alert('Bitte geben Sie Start- und Zielort ein.');
                    return;
                }

                searchBtn.disabled = true;
                searchBtn.innerHTML = '<span>Suche...</span>';

                const startCoords = await geocodeAddress(startInput);
                const endCoords = await geocodeAddress(endInput);

                if (startCoords && endCoords) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('startLat', startCoords.lat);
                    url.searchParams.set('startLon', startCoords.lon);
                    url.searchParams.set('endLat', endCoords.lat);
                    url.searchParams.set('endLon', endCoords.lon);

                    await fetchRidesWithoutReload(url.toString());
                    clearSearchBtn.style.display = 'inline-block';
                } else {
                    alert('Adressen nicht gefunden.');
                }

                searchBtn.disabled = false;
                searchBtn.innerHTML = '📍 Suchen';
            });

            // Spezifisches "Zurücksetzen" nur für die intelligente Suche (falls gewünscht)
            clearSearchBtn.addEventListener('click', function() {
                window.location.href = '@Url.Action("Index", "Ride")';
            });

            // --- 5. "FILTER LÖSCHEN" KNOPF FIX (Leitet sofort auf Hauptseite weiter) ---
            filterReset.addEventListener('click', function() {
                // Einfachster und sicherster Weg, um absolut alles zu säubern:
                window.location.href = '@Url.Action("Index", "Ride")';
            });

            searchStartInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') searchBtn.click(); });
            searchEndInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') searchBtn.click(); });

            // Sicherstellen, dass der Reset-Button beim Neuladen der Suche richtig initialisiert wird
            const initialUrl = new URL(window.location.href);
            if (initialUrl.searchParams.has('startLat')) {
                clearSearchBtn.style.display = 'inline-block';
            }

            rebindMainEvents();
            applyFilters();
        });
    </script>
}