        //Timer bis der Input Überprüft wird
        document.getElementById("startPositionId").addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(calculateRoute, 500);
        });
        document.getElementById("endPositionId").addEventListener("input", () => {
