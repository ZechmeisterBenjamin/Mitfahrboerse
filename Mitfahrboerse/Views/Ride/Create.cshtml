@model Mitfahrboerse.Models.t_Ride
@{
    ViewData["Title"] = "Fahrt erstellen";
    var positions = ViewBag.Positions as List<Mitfahrboerse.Models.t_Position> ?? new List<Mitfahrboerse.Models.t_Position>();
}
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css" />
<link rel="stylesheet" href="css/StyleSheet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

<style>
    .main-content-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start; 
        gap: 40px;
        margin-top: 50px;
    }


    #map-container {
        width: 600px; 
        height: 500px;
        border-radius: 15px;
        overflow: hidden;
        border: 4px solid #4d4d4d; 
    }

    #map {
        height: 100%;
        width: 100%;
    }

    /* Anpassungen für die Formular-Card, um die Breite des neuesten Bildes zu treffen */
    .card {
        width: 350px; /* Die Breite der Formularbox */
        background-color: #4d4d4d;
        color: white;
        border-radius: 15px;
    }

    .card-header {
        background-color: #666;
        border-radius: 15px 15px 0 0;
        padding: 15px;
    }

    .card-body {
        padding: 20px;
    }

    /* Styling für die Input-Felder, um dem neuesten Bild zu entsprechen */
    .form-control {
        background-color: #666; /* Dunklerer Hintergrund */
        color: white;
        border: none;
        padding: 10px;
        border-radius: 5px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }

    /* Buttons anpassen */
    .styled-button {
        width: 100%;
        margin-top: 10px;
    }

</style>

<div class="main-content-layout">

    <div class="card">
        <div class="card-header">
            <h3 class="text-center">Neue Fahrt erstellen</h3>
        </div>
        <div class="card-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label for="startPositionInput">Von:</label>
                    <input id="startPositionInput" name="startPositionDescription" class="form-control" type="text" placeholder="Startpunkt eingeben" required />
                    <input id="startPositionId" name="startPositionId" type="hidden" />
                </div>

                <div class="form-group mb-3">
                    <label for="endPositionInput">Nach:</label>
                    <input id="endPositionInput" name="endPositionDescription" class="form-control" type="text" placeholder="Ziel eingeben" required />
                    <input id="endPositionId" name="endPositionId" type="hidden" />
                </div>

                <div class="form-group mb-4">
                    <label for="">Wählen Sie Ihr Auto:</label>
                    <select for="" class="form-control" required>
                        <option value="">-- Auto auswählen --</option>
                    </select>
                    <span validation-for="" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="RideDateTime">Auto Wählen</label>
                    <input asp-for="RideDateTime" class="form-control" type="datetime-local" required />
                    <span asp-validation-for="RideDateTime" class="text-danger"></span>
                </div>
                <div class="form-group text-center mt-4">
                    <button id="showRouteBtn" type="button" class="styled-button">Route anzeigen</button>
                    <button type="submit" class="styled-button">Fahrt erstellen</button>
                </div>
            </form>
        </div>
    </div>

    <div id="map-container">
        <div id="map"></div>
    </div>

</div>

@section Scripts {
    <script>
        // Leaflet-Initialisierung - Karte zentriert auf HTL Waidhofen, ohne Route
        const map = L.map('map').setView([47.9505574, 14.7842044], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap-Mitwirkende'
        }).addTo(map);

        let control = null;
        let startMarker = null;
        let endMarker = null;

        async function geocodeAddress(address) {
            const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&countrycodes=AT`;
            try {
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error('Netzwerkfehler');
                }
                const data = await response.json();
                if (data && data.length > 0) {
                    return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
                }
            } catch (error) {
                console.error("Geocoding-Fehler:", error);
            }
            return null;
        }

        async function calculateRoute() {
            const startInput = document.getElementById('startPositionInput').value;
            const endInput = document.getElementById('endPositionInput').value;

            if (control) {
                map.removeControl(control);
                control = null;
            }
            if (startMarker) {
                map.removeLayer(startMarker);
                startMarker = null;
            }
            if (endMarker) {
                map.removeLayer(endMarker);
                endMarker = null;
            }

            if (startInput && endInput) {
                const startCoords = await geocodeAddress(startInput);
                const endCoords = await geocodeAddress(endInput);

                if (startCoords && endCoords) {
                    const icon = new L.Icon({
                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
                        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
                    });

                    // Start- und Endmarker hinzufügen
                    startMarker = L.marker(startCoords, { icon: icon }).addTo(map);
                    startMarker.bindPopup("Start: " + startInput).openPopup();

                    endMarker = L.marker(endCoords, { icon: icon }).addTo(map);
                    endMarker.bindPopup("Ziel: " + endInput).openPopup();

                    // Route erstellen und hinzufügen
                    control = L.Routing.control({
                        waypoints: [
                            L.latLng(startCoords[0], startCoords[1]),
                            L.latLng(endCoords[0], endCoords[1])
                        ],
                        routeWhileDragging: true,
                        lineOptions: {
                            styles: [{ color: '#1a75ff', opacity: 1, weight: 5 }]
                        },
                        show: false, 
                        collapsed: true,
                        createMarker: function () { return null; },
                        language: 'de'
                    }).addTo(map);

   
                    control.on('routesfound', function (e) {
                        const routes = e.routes;
                        const bounds = L.latLngBounds(routes[0].coordinates);
                        map.fitBounds(bounds, { padding: L.point(50, 50) });
                    });

                } else {
                    alert('Eine oder beide Adressen konnten nicht gefunden werden. Bitte überprüfen Sie Ihre Eingaben.');
                }
            }
        }

        document.getElementById("showRouteBtn").addEventListener("click", calculateRoute);
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}