@model Mitfahrboerse.Models.t_Ride
@{
    ViewData["Title"] = "Fahrt erstellen";
    var positions = ViewBag.Positions as List<Mitfahrboerse.Models.t_Position> ?? new List<Mitfahrboerse.Models.t_Position>();
}
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css" />
<link rel="stylesheet" href="css/StyleSheet.css"/>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

<style>
    #map {
        height: 180px;
    }
</style>
<div class="container" style="margin-top: 30px;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card" style="background-color: #4d4d4d; color: white; border-radius: 15px;">
                <div class="card-header" style="background-color: #666; border-radius: 15px 15px 0 0;">
                    <h3 class="text-center">Neue Fahrt erstellen</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-success">@TempData["Message"]</div>
                    }
                    
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="form-group mb-3">
                            <label for="startPositionId">Von:</label>
                            <select id="startPositionId" name="startPositionId" class="form-control" required>
                                <option value="">-- Startpunkt auswählen --</option>
                                @foreach (var position in positions)
                                {
                                    <option value="@position.PositionId">@position.Description</option>
                                }
                            </select>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label for="endPositionId">Nach:</label>
                            <select id="endPositionId" name="endPositionId" class="form-control" required>
                                <option value="">-- Ziel auswählen --</option>
                                @foreach (var position in positions)
                                {
                                    <option value="@position.PositionId">@position.Description</option>
                                }
                            </select>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="RideDateTime">Datum und Uhrzeit:</label>
                            <input asp-for="RideDateTime" class="form-control" type="datetime-local" required />
                            <span asp-validation-for="RideDateTime" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group text-center mt-4">
                            <button type="submit" class="styled-button">Fahrt erstellen</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="map"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startSelect = document.getElementById('startPositionId');
            const endSelect = document.getElementById('endPositionId');
            
            function updateOptions() {
                const startValue = startSelect.value;
                const endValue = endSelect.value;
                
                Array.from(startSelect.options).forEach(option => {
                    option.disabled = false;
                });
                
                Array.from(endSelect.options).forEach(option => {
                    option.disabled = false;
                });
                
                if (startValue) {
                    const endOption = Array.from(endSelect.options).find(o => o.value === startValue);
                    if (endOption) endOption.disabled = true;
                }
                
                if (endValue) {
                    const startOption = Array.from(startSelect.options).find(o => o.value === endValue);
                    if (startOption) startOption.disabled = true;
                }
            }
            
            startSelect.addEventListener('change', updateOptions);
            endSelect.addEventListener('change', updateOptions);
            
            updateOptions();
        });


        const map = L.map('map').setView([47.9505574, 14.7842044], 16); // Start: HTL Waidhofen/Ybbs

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap-Mitwirkende'
        }).addTo(map);

        let control = null;
        let debounceTimer;

        function getPositionCoordinates(positionId) {
           const positions = @Html.Raw(Json.Serialize(ViewBag.Positions as List<Mitfahrboerse.Models.t_Position>));
           const position = positions.find(p => p.PositionId.toString() === positionId);
        return position ? [position.Latitude, position.Longitude] : null;
        }

        async function calculateRoute() {
                            const startSelect = document.getElementById('startPositionId');
                            const endSelect = document.getElementById('endPositionId');
                            const startPositionId = startSelect.value;
                            const endPositionId = endSelect.value;

                            if (control) {
                                map.removeControl(control);
                                control = null;
                            }

                            if (startPositionId && endPositionId) {
                                const startCoords = getPositionCoordinates(startPositionId);
                                const endCoords = getPositionCoordinates(endPositionId);

                                if (startCoords && endCoords) {
                                    control = L.Routing.control({
                                        waypoints: [
                                            L.latLng(startCoords[0], startCoords[1]),
                                            L.latLng(endCoords[0], endCoords[1])
                                        ],
                                        routeWhileDragging: true,
                                        lineOptions: {
                                            styles: [{color: '#6fa1ec', opacity: 1, weight: 5}]
                                        },
                                        createMarker: function(i, waypoint, n) {
                                            const iconUrl = i === 0 ? 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png' :
                                                            i === n - 1 ? 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png' :
                                                            'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png';
                                            const icon = new L.Icon({
                                                iconUrl: iconUrl,
                                                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                                                iconSize: [25, 41],
                                                iconAnchor: [12, 41],
                                                popupAnchor: [1, -34],
                                                shadowSize: [41, 41]
                                            });
                                            return L.marker(waypoint.latLng, {icon: icon});
                                        },
                                        language: 'de'
                                    }).addTo(map);
                                }
                            }
                        }
            document.getElementById("startPositionId").addEventListener("change", calculateRoute);
    document.getElementById("endPositionId").addEventListener("change", calculateRoute);
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}