@{
    ViewData["Title"] = "Fahrt erstellen";
}

<div class="container" style="display: flex; justify-content: center; gap: 30px; margin: 40px;">
    <div class="info-box">
        <p><strong>Von:</strong></p>
        <input type="text" placeholder="Startpunkt eingeben">
        <p><strong>Nach:</strong></p>
        <input type="text" placeholder="Ziel eingeben">
        <p><strong>Um:</strong></p>
        <input type="time">
        <p><strong>Auto:</strong></p>
        <input type="text" placeholder="Auto">
        <button class="styled-button">Fahrt erstellen</button>
    </div>
    <div class="map-box">
        <h1>Hier wird die Karte eingebunden</h1>
    </div>
</div>