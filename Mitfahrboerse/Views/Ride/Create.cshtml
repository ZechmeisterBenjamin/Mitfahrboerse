@model Mitfahrboerse.Models.t_Ride
@{
    ViewData["Title"] = "Fahrt erstellen";
    var positions = ViewBag.Positions as List<Mitfahrboerse.Models.t_Position> ?? new List<Mitfahrboerse.Models.t_Position>();

    var userCars = ViewBag.UserCars as List<Mitfahrboerse.Models.t_Car> ?? new List<Mitfahrboerse.Models.t_Car>();
}
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"/>
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css"/>
<link rel="stylesheet" href="css/StyleSheet.css"/>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

<style>
    .main-content-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 40px;
        margin-top: 50px;
    }

    #map-container {
        width: 700px;
        height: 600px;
        border-radius: 15px;
        overflow: hidden;
        border: 4px solid #4d4d4d;
    }

    #map {
        height: 100%;
        width: 100%;
    }

    .card {
        width: 350px;
        background-color: #4d4d4d;
        color: white;
        border-radius: 15px;
    }

    .card-header {
        background-color: #666;
        border-radius: 15px 15px 0 0;
        padding: 15px;
    }

    .card-body {
        padding: 20px;
    }

    .form-control {
        background-color: #666;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 5px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }

    .styled-button {
        width: 100%;
        margin-top: 10px;
    }
</style>

<div class="main-content-layout">

    <div class="card">
        <div class="card-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label for="startPositionInput">Von:</label>
                    <input id="startPositionInput" name="startPositionDescription" class="form-control" type="text"
                           placeholder="Startpunkt eingeben" required/>
                    <input id="startLat" name="startLat" type="hidden"/>
                    <input id="startLon" name="startLon" type="hidden"/>
                </div>

                <div class="form-group mb-3">
                    <label for="endPositionInput">Nach:</label>
                    <input id="endPositionInput" name="endPositionDescription" class="form-control" type="text"
                           placeholder="Ziel eingeben" required/>
                    <input id="endLat" name="endLat" type="hidden"/>
                    <input id="endLon" name="endLon" type="hidden"/>
                </div>

                <div class="form-group mb-4">
                    <label for="carId">Wählen Sie Ihr Auto:</label>
                    <select id="carId" name="carId" class="form-control" required>
                        <option value="">-- Auto auswählen --</option>
                        @foreach (var car in userCars)
                        {
                            <option value="@car.CarId">@car.Brand @car.Model (@car.LicensePlate)</option>
                        }
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label for="rideDateTime">Datum & Uhrzeit</label>
                    <input id="rideDateTime" name="rideDateTime" class="form-control" type="datetime-local" required/>
                    <span asp-validation-for="RideDateTime" class="text-danger"></span>
                </div>

                <div class="form-group text-center mt-4">
                    <button id="showRouteBtn" type="button" class="styled-button">Route anzeigen</button>
                    <button type="submit" class="styled-button">Fahrt erstellen</button>

                    <label id="routeLengthLabel" style="display:block; margin-top:15px; font-weight:bold;"></label>
                    <input id="routeLength" name="routeLength" type="hidden"/>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Leaflet initialisieren
        const map = L.map('map').setView([47.9505574, 14.7842044], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap-Mitwirkende'
        }).addTo(map);

        let control = null;
        let startMarker = null;
        let endMarker = null;

        async function geocodeAddress(address) {
            const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&countrycodes=AT`;
            try {
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error('Netzwerkfehler');
                }
                const data = await response.json();
                if (data && data.length > 0) {
                    return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
                }
            } catch (error) {
                console.error("Geocoding-Fehler:", error);
            }
            return null;
        }

        async function calculateRoute() {
            const startInput = document.getElementById('startPositionInput').value;
            const endInput = document.getElementById('endPositionInput').value;

            // Vorherige Route & Marker entfernen
            if (control) {
                map.removeControl(control);
                control = null;
            }
            if (startMarker) {
                map.removeLayer(startMarker);
                startMarker = null;
            }
            if (endMarker) {
                map.removeLayer(endMarker);
                endMarker = null;
            }

            if (startInput && endInput) {
                const startCoords = await geocodeAddress(startInput);
                const endCoords = await geocodeAddress(endInput);

                if (startCoords && endCoords) {
                    const icon = new L.Icon({
                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
                        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
                    });

                    startMarker = L.marker(startCoords, {icon: icon}).addTo(map);
                    startMarker.bindPopup("Start: " + startInput).openPopup();

                    endMarker = L.marker(endCoords, {icon: icon}).addTo(map);
                    endMarker.bindPopup("Ziel: " + endInput).openPopup();

                    document.getElementById("startLat").value = startCoords[0];
                    document.getElementById("startLon").value = startCoords[1];
                    document.getElementById("endLat").value = endCoords[0];
                    document.getElementById("endLon").value = endCoords[1];

                    // Route erzeugen
                    control = L.Routing.control({
                        waypoints: [
                            L.latLng(startCoords[0], startCoords[1]),
                            L.latLng(endCoords[0], endCoords[1])
                        ],
                        routeWhileDragging: true,
                        lineOptions: {
                            styles: [{color: '#1a75ff', opacity: 1, weight: 5}]
                        },
                        show: false,
                        collapsed: true,
                        createMarker: function () {
                            return null;
                        },
                        language: 'de'
                    }).addTo(map);

                    // Event: Route gefunden
                    control.on('routesfound', function (e) {
                        const route = e.routes[0];
                        const distanceMeters = route.summary.totalDistance;
                        const distanceKm = (distanceMeters / 1000).toFixed(2);

                        // Label aktualisieren
                        document.getElementById("routeLengthLabel").textContent = `Routenlänge: ${distanceKm} km`;

                        // Hidden Field für Controller
                        document.getElementById("routeLength").value = distanceKm;

                        // Karte auf Route anpassen
                        const bounds = L.latLngBounds(route.coordinates);
                        map.fitBounds(bounds, {padding: L.point(50, 50)});
                    });

                } else {
                    alert('Eine oder beide Adressen konnten nicht gefunden werden. Bitte überprüfen Sie Ihre Eingaben.');
                }
            }
        }

        document.getElementById("showRouteBtn").addEventListener("click", calculateRoute);
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}