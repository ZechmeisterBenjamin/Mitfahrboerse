@model Mitfahrboerse.Models.t_Person
@{
    ViewData["Title"] = "Fahrten verwalten";
}

<main class="manage-rides-container" style="display: flex; gap: 20px; padding: 20px; align-items: stretch;">

    <div style="flex: 1; background-color: #666; border-radius: 15px; padding: 20px; display: flex; flex-direction: column;">
        <div class="rides-header" style="border-bottom: 1px solid #777; margin-bottom: 15px; padding-bottom: 5px;">
            <h3 style="margin: 0; color: white;">Geplante Fahrten (Fahrer)</h3>
        </div>

        <div class="rides-list-container" style="flex-grow: 1;">
            <div class="no-rides-message" style="display: @(Model?.t_Rides != null && Model.t_Rides.Any() ? "none" : "block"); background-color: #444; border-radius: 10px; padding: 40px; text-align: center;">
                <div class="empty-state"><p style="color: white; font-weight: bold; margin: 0;">Keine Fahrten als Fahrer</p></div>
            </div>

            @if (Model?.t_Rides != null)
            {
                @foreach (var ride in Model.t_Rides.OrderBy(r => r.RideDateTime))
                {
                    var occupied = ride.PersonRides?.Count(pr => pr.Status == 0) ?? 0;
                    <div class="fahrt-item" id="ride-@ride.RideId" style="margin-bottom: 15px; background-color: #444; border-radius: 10px; padding: 15px; position: relative;">
                        <div class="fahrt-item-content">
                            <div class="fahrt-item-header" style="position: relative; width: 100%; min-height: 30px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px;">

                                <strong style="color: #ffd700; font-size: 1.1em; text-align: center;">
                                    @ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName
                                </strong>

                                <span class="seats-badge available"
                                      style="position: absolute; right: 0; top: 0; background-color: #5cb85c; color: white; padding: 4px 10px; border-radius: 10px; font-size: 0.85em; cursor: pointer; border: none; z-index: 10;"
                                      onclick="showPassengers(@ride.RideId, '@ride.RideDateTime.ToString("dd.MM HH:mm")')">
                                    @occupied Mitfahrer
                                </span>
                            </div>

                            <div style="text-align: center; color: white;">
                                <div style="margin-bottom: 5px; font-weight: bold;">@ride.FK_StartsAt_Position?.Description → @ride.FK_EndsAt_Position?.Description</div>
                                <div style="font-size: 0.9em; opacity: 0.9;">@ride.RideDateTime.ToString("dd.MM.yyyy | HH:mm")</div>
                            </div>

                            <button class="anfrage-button" style="width: 100%; margin-top: 15px; background: transparent; border: 2px solid white; color: white; border-radius: 20px; padding: 8px; cursor: pointer;" onclick="cancelRide(@ride.RideId)">
                                <span>Fahrt stornieren</span>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div style="flex: 1; background-color: #666; border-radius: 15px; padding: 20px; display: flex; flex-direction: column;">
        <div class="rides-header" style="border-bottom: 1px solid #777; margin-bottom: 15px; padding-bottom: 5px;">
            <h3 style="margin: 0; color: white;">Meine Mitfahrten (Passagier)</h3>
        </div>

        <div class="rides-list-container" style="flex-grow: 1;">
            <div class="no-rides-message" style="display: @(Model?.PersonRides != null && Model.PersonRides.Any() ? "none" : "block"); background-color: #444; border-radius: 10px; padding: 40px; text-align: center;">
                <div class="empty-state"><p style="color: white; font-weight: bold; margin: 0;">Keine Mitfahrten als Passagier</p></div>
            </div>

            @if (Model?.PersonRides != null)
            {
                @foreach (var pr in Model.PersonRides.OrderBy(x => x.Ride?.RideDateTime))
                {
                    <div class="fahrt-item" id="passenger-ride-@pr.FK_RideId" style="margin-bottom: 15px; background-color: #444; border-radius: 10px; padding: 15px; position: relative;">
                        <div class="fahrt-item-content">
                            <div class="fahrt-item-header" style="position: relative; width: 100%; min-height: 30px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px;">

                                <strong style="color: #ffd700; font-size: 1.1em; text-align: center;">
                                    @(pr.Ride?.FK_Driver_Person?.FirstName) @(pr.Ride?.FK_Driver_Person?.LastName)
                                </strong>

                                <span class="seats-badge"
                                      style="position: absolute; right: 0; top: 0; padding: 4px 10px; border-radius: 10px; font-size: 0.85em; color: white;
                     background-color: @(pr.Status == 0 ? "#5cb85c" : (pr.Status == 2 ? "#d9534f" : "#f0ad4e"));">

                                    @if (pr.Status == 0)
                                    {
                                        @:Bestätigt
                                    }
                                    else if (pr.Status == 2)
                                    {
                                        @:Abgelehnt
                                    }
                                    else
                                    {
                                        @:Offen
                                    }
                                </span>
                            </div>

                            <div style="text-align: center; color: white;">
                                <div style="margin-bottom: 5px; font-weight: bold;">@pr.Ride?.FK_StartsAt_Position?.Description → @pr.Ride?.FK_EndsAt_Position?.Description</div>
                                <div style="font-size: 0.9em; opacity: 0.9;">@(pr.Ride?.RideDateTime.ToString("dd.MM.yyyy | HH:mm") ?? "")</div>
                            </div>

                            <button class="anfrage-button" style="width: 100%; margin-top: 15px; background: transparent; border: 2px solid white; color: white; border-radius: 20px; padding: 8px; cursor: pointer;" onclick="leaveRide(@pr.FK_RideId)">
                                <span>Teilnahme absagen</span>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</main>

<div id="passengersModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="background-color: #2c2c2c; border: 1px solid #444;">
        <h3 id="modalTitle" style="color: #ffd60a; margin-top: 0;">Mitfahrer-Liste</h3>
        <ul id="passengersList" style="list-style: none; padding: 0; margin: 20px 0;">
        </ul>
        <button class="anfrage-button" style="width: 100%;" onclick="closeModal()">
            <span>Schließen</span>
        </button>
    </div>
</div>

@section Scripts {
    <script>


        function closeModal() {
            document.getElementById('passengersModal').style.display = 'none';
        }

        function showPassengers(rideId, timeStr) {
            const modal = document.getElementById('passengersModal');
            const list = document.getElementById('passengersList');
            document.getElementById('modalTitle').innerText = "Mitfahrer: " + timeStr;

            list.innerHTML = '<li style="color: white; text-align: center;">Lade...</li>';
            modal.style.display = 'flex';

            $.get('/CheckRides/GetPassengers', { rideId: rideId })
                .done(function(data) {
                    list.innerHTML = '';
                    if (!data || data.length === 0) {
                        list.innerHTML = '<li style="color: white; text-align: center;">Keine Mitfahrer gefunden.</li>';
                    } else {
                        data.forEach(p => {
                            list.innerHTML += `
                                <li style="padding: 12px; border-bottom: 1px solid #444; display: flex; flex-direction: column;">
                                    <span style="font-weight: bold; color: white; font-size: 1.1rem;">${p.name}</span>
                                    <span style="color: #ffd60a; font-size: 0.9rem;">${p.klasse || 'Keine Klasse'}</span>
                                </li>`;
                        });
                    }
                });
        }

        function cancelRide(id) {
            if(confirm("Diese Fahrt wirklich löschen?")) {
                $.post('@Url.Action("CancelRide")', { rideId: id }, function(res) {
                    if(res.success) {
                        const $item = $(`#ride-${id}`);
                        const $container = $item.closest('.rides-list-container');

                        $item.remove();

                        if ($container.find('.fahrt-item').length === 0) {
                            $container.find('.no-rides-message').show();
                        }

                        const alertDiv = document.getElementById('rideAlert');
                        if(alertDiv) {
                            const alertText = document.getElementById('rideAlertText');
                            alertText.innerHTML = res.rideDetails;
                            alertDiv.style.display = 'block';
                        }
                    } else {
                        alert(res.message);
                    }
                });
            }
        }

        function leaveRide(id) {
            if(confirm("Möchtest du die Mitfahrt wirklich absagen?")) {
                $.post('@Url.Action("LeaveRide")', { rideId: id }, function(res) {
                    if(res.success) {
                        const $item = $(`#passenger-ride-${id}`);
                        const $container = $item.closest('.rides-list-container');

                        $item.remove();

                        if ($container.find('.fahrt-item').length === 0) {
                            $container.find('.no-rides-message').show();
                        }
                    } else {
                        alert(res.message);
                    }
                });
            }
        }
    </script>
}