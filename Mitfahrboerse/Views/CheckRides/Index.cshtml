@model Mitfahrboerse.Models.t_Person
@{
    ViewData["Title"] = "Fahrten verwalten";
}

<main class="manage-rides-container" style="display: flex; gap: 20px; padding: 20px;">

    <div class="left-column" style="flex: 1; display: flex; flex-direction: column;">
        <div class="rides-header">
            <h3>Geplante Fahrten (Fahrer)</h3>
        </div>

        <div class="rides-list-container" style="flex-grow: 1;">
            @if (Model?.t_Rides != null && Model.t_Rides.Any())
            {
                @foreach (var ride in Model.t_Rides.OrderBy(r => r.RideDateTime))
                {
                    var occupied = ride.PersonRides?.Count(pr => pr.Status == 0) ?? 0;

                    <div class="fahrt-item" id="ride-@ride.RideId">
                        <div class="fahrt-item-content">
                            <div class="fahrt-item-header">
                                <strong class="driver-name">@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName</strong>
                                <span class="seats-badge available" style="cursor: pointer; border: none;" onclick="showPassengers(@ride.RideId, '@ride.RideDateTime.ToString("dd.MM HH:mm")')">
                                    @occupied Mitfahrer
                                </span>
                            </div>

                            <div class="fahrt-item-route">
                                <strong>@ride.FK_StartsAt_Position?.Description</strong> → <strong>@ride.FK_EndsAt_Position?.Description</strong>
                            </div>

                            <div class="fahrt-item-time">
                                @ride.RideDateTime.ToString("dd.MM.yyyy") | @ride.RideDateTime.ToString("HH:mm")
                            </div>

                            <button class="anfrage-button" style="width: 100%; margin-top: 10px;" onclick="cancelRide(@ride.RideId)">
                                <span>Fahrt stornieren</span>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-rides-message" style="display: block;">
                    <div class="empty-state"><p>Keine Fahrten als Fahrer</p></div>
                </div>
            }
        </div>
    </div>

    <div class="right-column" style="flex: 1; display: flex; flex-direction: column; background-color: #666;">
        <div class="rides-header">
            <h3>Meine Mitfahrten (Passagier)</h3>
        </div>

        <div class="rides-list-container" style="flex-grow: 1;">
            @if (Model?.PersonRides != null && Model.PersonRides.Any())
            {
                @foreach (var pr in Model.PersonRides.OrderBy(x => x.Ride?.RideDateTime))
                {
                    <div class="fahrt-item" id="passenger-ride-@pr.FK_RideId">
                        <div class="fahrt-item-content">
                            <div class="fahrt-item-header">
                                <strong class="driver-name">@(pr.Ride?.FK_Driver_Person?.FirstName) @(pr.Ride?.FK_Driver_Person?.LastName)</strong>
                                <span class="seats-badge @(pr.Status == 0 ? "available" : "full")">
                                    @(pr.Status == 0 ? "Bestätigt" : "Offen")
                                </span>
                            </div>

                            <div class="fahrt-item-route">
                                <strong>@pr.Ride?.FK_StartsAt_Position?.Description</strong> → <strong>@pr.Ride?.FK_EndsAt_Position?.Description</strong>
                            </div>

                            <div class="fahrt-item-time">
                                @(pr.Ride?.RideDateTime.ToString("dd.MM.yyyy") ?? "") | @(pr.Ride?.RideDateTime.ToString("HH:mm") ?? "")
                            </div>

                            <button class="anfrage-button" style="width: 100%; margin-top: 10px;" onclick="leaveRide(@pr.FK_RideId)">
                                <span>Teilnahme absagen</span>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-rides-message" style="display: block;">
                    <div class="empty-state"><p>Keine Mitfahrten als Passagier</p></div>
                </div>
            }
        </div>
    </div>
</main>

<div id="passengersModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="background-color: #2c2c2c; border: 1px solid #444;">
        <h3 id="modalTitle" style="color: #ffd60a; margin-top: 0;">Mitfahrer-Liste</h3>
        <ul id="passengersList" style="list-style: none; padding: 0; margin: 20px 0;">
        </ul>
        <button class="anfrage-button" style="width: 100%;" onclick="closeModal()">
            <span>Schließen</span>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        function closeModal() {
            document.getElementById('passengersModal').style.display = 'none';
        }

        function showPassengers(rideId, timeStr) {
            const modal = document.getElementById('passengersModal');
            const list = document.getElementById('passengersList');
            document.getElementById('modalTitle').innerText = "Mitfahrer: " + timeStr;

            list.innerHTML = '<li style="color: white; text-align: center;">Lade...</li>';
            modal.style.display = 'flex';

            $.get('/CheckRides/GetPassengers', { rideId: rideId })
                .done(function(data) {
                    list.innerHTML = '';
                    if (!data || data.length === 0) {
                        list.innerHTML = '<li style="color: white; text-align: center;">Keine Mitfahrer gefunden.</li>';
                    } else {
                        data.forEach(p => {
                            list.innerHTML += `
                                <li style="padding: 12px; border-bottom: 1px solid #444; display: flex; flex-direction: column;">
                                    <span style="font-weight: bold; color: white; font-size: 1.1rem;">${p.name}</span>
                                    <span style="color: #ffd60a; font-size: 0.9rem;">${p.klasse || 'Keine Klasse'}</span>
                                </li>`;
                        });
                    }
                });
        }

        function cancelRide(id) {
            if(confirm("Diese Fahrt wirklich löschen?")) {
                $.post('@Url.Action("CancelRide")', { rideId: id }, function(res) {
                    if(res.success) {
                        const alertDiv = document.getElementById('rideAlert');
                        const alertText = document.getElementById('rideAlertText');
                        alertText.innerHTML = res.rideDetails; 
                        alertDiv.style.display = 'block';

                        setTimeout(() => {
                            alertDiv.classList.add('alert-fade-out');
                            setTimeout(() => {
                                alertDiv.style.display = 'none';
                                alertDiv.classList.remove('alert-fade-out');
                            }, 500);
                        }, 5000);

                        $(`#ride-${id}`).fadeOut();
                    } else {
                        alert(res.message);
                    }
                });
            }
        }

        function leaveRide(id) {
            if(confirm("Möchtest du die Mitfahrt wirklich absagen?")) {
                $.post('@Url.Action("LeaveRide")', { rideId: id }, function(res) {
                    if(res.success) {
                        $(`#passenger-ride-${id}`).fadeOut();
                    } else {
                        alert(res.message);
                    }
                });
            }
        }
    </script>
}