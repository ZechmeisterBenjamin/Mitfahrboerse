@model Mitfahrboerse.Models.t_Person
@{
    ViewData["Title"] = "Fahrten verwalten";
}

<style>
    /* 1. Globales Scrollen komplett unterbinden */
    html, body {
        height: 100vh;
        width: 100vw;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        background-color: #ffffff !important;
    }

    /* 2. Der Wrapper erzwingt die Box in den Viewport */
    .page-wrapper {
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: column;
        padding: 2vh 3vw; /* Dynamische Abstände basierend auf Viewport */
        box-sizing: border-box;
    }

    /* 3. Die Dashboard-Box - Symmetrisch abgerundet */
    .dashboard-container {
        background-color: #474747;
        border-radius: 20px;
        padding: 30px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
        overflow: hidden;
        min-height: 0; /* Wichtig für Flexbox-Scrolling */
    }

    /* 4. Listen-Bereich */
    .rides-list-container {
        flex-grow: 1;
        overflow-y: auto;
        padding-right: 15px;
        scrollbar-gutter: stable;
    }

        /* Scrollbar */
        .rides-list-container::-webkit-scrollbar {
            width: 6px;
        }

        .rides-list-container::-webkit-scrollbar-thumb {
            background: #666;
            border-radius: 10px;
        }

            .rides-list-container::-webkit-scrollbar-thumb:hover {
                background: #ffd60a;
            }

    /* Schriftfarben & Design */
    .column-title {
        color: #ffd60a;
        font-weight: bold;
        text-align: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
    }

    .fahrt-item-custom {
        background-color: #3d3d3d;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 20px;
        border: 1px solid #555;
        position: relative;
    }

    .selected-ride {
        border-left: 5px solid #ffd60a;
    }

    /* Datum & Zeit jetzt wieder in Weiß */
    .datetime-display {
        text-align: center;
        color: #ffffff !important; /* Weiß erzwungen */
        font-weight: 500;
        margin-bottom: 15px;
        font-size: 1rem;
    }

    .driver-name-centered {
        color: #ffd60a;
        font-weight: bold;
        display: block;
        font-size: 1.3rem;
        margin-bottom: 10px;
        text-align: center;
    }

    .route-display {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 15px 0;
        color: white;
    }

    .route-line {
        flex-grow: 1;
        height: 1px;
        background: #888;
        position: relative;
    }

    .route-arrow {
        position: absolute;
        right: -2px;
        top: -8px;
        font-size: 12px;
        color: #4285f4;
    }

    /* Buttons */
    .status-badge-top {
        position: absolute;
        top: 15px;
        right: 15px;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: bold;
        border: none;
    }

    .bg-available {
        background-color: #4caf50;
        color: white;
    }

    .bg-status {
        background-color: #ffd60a;
        color: #333;
    }

    .action-button-full {
        width: 100%;
        background-color: #555;
        border: none;
        color: white;
        padding: 10px;
        border-radius: 8px;
        font-weight: bold;
        transition: 0.2s;
    }

        .action-button-full:hover {
            background-color: #dc3545;
        }

    .row.h-100 {
        flex-shrink: 1;
        overflow: hidden;
    }
</style>

<div class="page-wrapper">
    <div class="dashboard-container">
        <div class="row h-100">

            <div class="col-md-6 px-4 d-flex flex-column" style="border-right: 1px solid #555;">
                <h3 class="column-title">Geplante Fahrten (Fahrer)</h3>
                <div class="rides-list-container">
                    @if (Model?.t_Rides != null && Model.t_Rides.Any())
                    {
                        @foreach (var ride in Model.t_Rides.OrderBy(r => r.RideDateTime))
                        {
                            var occupied = ride.PersonRides?.Count(pr => pr.Status == 0) ?? 0;
                            <div class="fahrt-item-custom" id="ride-@ride.RideId">
                                <button class="status-badge-top bg-available" onclick="showPassengers(@ride.RideId, '@ride.RideDateTime.ToString("dd.MM HH:mm")')">
                                    @occupied Mitfahrer
                                </button>
                                <span class="driver-name-centered">@ride.FK_Driver_Person.FirstName @ride.FK_Driver_Person.LastName</span>
                                <div class="route-display">
                                    <span style="font-weight: bold;">@ride.FK_StartsAt_Position?.Description</span>
                                    <div class="route-line"><span class="route-arrow">▶</span></div>
                                    <span style="font-weight: bold;">@ride.FK_EndsAt_Position?.Description</span>
                                </div>
                                <div class="datetime-display">@ride.RideDateTime.ToString("dd.MM.yyyy | HH:mm") Uhr</div>
                                <button class="action-button-full" onclick="cancelRide(@ride.RideId)">Fahrt stornieren</button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-md-6 px-4 d-flex flex-column">
                <h3 class="column-title">Meine Mitfahrten (Passagier)</h3>
                <div class="rides-list-container">
                    @if (Model?.PersonRides != null && Model.PersonRides.Any())
                    {
                        @foreach (var pr in Model.PersonRides.OrderBy(x => x.Ride?.RideDateTime))
                        {
                            <div class="fahrt-item-custom selected-ride" id="passenger-ride-@pr.FK_RideId">
                                <span class="status-badge-top @(pr.Status == 0 ? "bg-available" : "bg-status")">
                                    @(pr.Status == 0 ? "Bestätigt" : "Offen")
                                </span>
                                <span class="driver-name-centered">@(pr.Ride?.FK_Driver_Person?.FirstName) @(pr.Ride?.FK_Driver_Person?.LastName)</span>
                                <div class="route-display">
                                    <span style="font-weight: bold;">@pr.Ride?.FK_StartsAt_Position?.Description</span>
                                    <div class="route-line"><span class="route-arrow">▶</span></div>
                                    <span style="font-weight: bold;">@pr.Ride?.FK_EndsAt_Position?.Description</span>
                                </div>
                                <div class="datetime-display">@pr.Ride?.RideDateTime.ToString("dd.MM.yyyy | HH:mm") Uhr</div>
                                <button class="action-button-full" onclick="leaveRide(@pr.FK_RideId)">Teilnahme absagen</button>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</div>
<div id="passengersModal" class="admin-modal" style="display:none; position:fixed; z-index:1001; left:0; top:0; width:100%; height:100%; background-color: rgba(0,0,0,0.8);">
    <div style="background-color: #2c2c2c; margin: 10% auto; padding: 20px; width: 450px; border-radius: 10px; border: 1px solid #444;">
        <h3 style="color: #ffcc00; margin-bottom: 5px;">Mitfahrer-Liste</h3>
        <p id="rideInfoSubtitle" style="color: #888; font-size: 0.85em; margin-bottom: 15px;"></p>
        <hr style="background: #444; height: 1px; border: none;">

        <div id="passengersList" style="max-height: 300px; overflow-y: auto; color: white; margin-top: 15px;">
        </div>

        <button onclick="document.getElementById('passengersModal').style.display='none'"
                style="width: 100%; margin-top: 20px; background: #555; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer;">
            Schließen
        </button>
    </div>
</div>

@section Scripts {
    <script>
        function cancelRide(rideId) {
            if (!confirm("Möchtest du diese Fahrt wirklich stornieren? Alle Mitfahrer werden entfernt.")) return;

            const params = new URLSearchParams();
            params.append('rideId', rideId);

            fetch('@Url.Action("CancelRide", "Profil")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const element = document.getElementById(`ride-${rideId}`);
                    if (element) element.style.display = 'none';
                    alert(data.message);
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function leaveRide(rideId) {
            if (!confirm("Möchtest du deine Teilnahme an dieser Fahrt wirklich absagen?")) return;

            const params = new URLSearchParams();
            params.append('rideId', rideId);

            fetch('@Url.Action("LeaveRide", "Profil")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const element = document.getElementById(`passenger-ride-${rideId}`);
                    if (element) element.style.display = 'none';
                    alert(data.message);
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function showPassengers(rideId, rideTime) {
            const modal = document.getElementById('passengersModal');
            const listContainer = document.getElementById('passengersList');
            const subtitle = document.getElementById('rideInfoSubtitle');

            subtitle.textContent = "Fahrt am " + rideTime + " Uhr";
            listContainer.innerHTML = '<div style="text-align:center; padding:20px;">Lade Mitfahrer...</div>';
            modal.style.display = 'block';

            fetch(`/Profil/GetRidePassengers?rideId=${rideId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.length === 0) {
                        listContainer.innerHTML = "<p style='padding:10px;'>Noch keine Mitfahrer für diese Fahrt.</p>";
                        return;
                    }

                    let html = '<table style="width: 100%; border-collapse: collapse;">';
                    html += '<tr style="color: #aaa; font-size: 0.8em; text-align: left;"><th style="padding: 5px;">Name</th><th>Klasse</th></tr>';

                    data.forEach(p => {
                        html += `<tr style="border-bottom: 1px solid #444;">
                                    <td style="padding: 10px 5px;">${p.userName}</td>
                                    <td style="padding: 10px 5px; color: #ffcc00;">${p.klasse}</td>
                                 </tr>`;
                    });
                    html += '</table>';
                    listContainer.innerHTML = html;
                })
                .catch(err => {
                    listContainer.innerHTML = "<p style='color: #d9534f; padding:10px;'>Fehler beim Laden der Daten.</p>";
                    console.error(err);
                });
        }
    </script>
}