@{
    int coinBalance = 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mitfahrboerse</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Mitfahrboerse.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
<header>
    <nav>
        <div class="logo">
            <img src="https://upload.wikimedia.org/wikipedia/commons/f/fb/HTL_Waidhofen_Ybbs.png" alt="HTL Logo"/>
        </div>
        <div class="menu">
            <div class="menu-item"><a asp-controller="Ride" asp-action="Index"><span>Mitfahren</span></a></div>
            <div class="menu-item"><a asp-controller="Ride" asp-action="Create"><span>Fahrt erstellen</span></a></div>
            <div class="menu-item"><a asp-controller="Shop" asp-action="Index"><span>Shop</span></a></div>
            <div class="menu-item"><a asp-controller="Profil" asp-action="Index"><span>Profil</span></a></div>
                <div class="profilepic">
                    <a asp-controller="Profil, Ride, Shop" asp-action="Index">
                        <img src="@ViewData["ProfilePicture"]" alt="Profilbild" style="width:50px; height:50px; border-radius:50%;"/>
                    </a>
            </div>
        </div>
        <div class="coin-balance">
            <span>@coinBalance</span>
            <img
                src="https://images.vexels.com/media/users/3/130116/isolated/preview/215a871596b92451a1678e36960c0ab7-dollar-coin-icon.png"
                alt="Coins"/>
        </div>
    </nav>
</header>

@RenderBody()

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>