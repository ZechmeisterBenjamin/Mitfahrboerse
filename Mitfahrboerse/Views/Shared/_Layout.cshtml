@{
    int coinBalance = (int)(ViewData["CoinBalance"] ?? 0);
    int selectedDesign = Convert.ToInt32(ViewData["SelectedDesign"] ?? 0);
    
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    Func<string, string, string> GetActive = (controller, action) =>
        (currentController == controller && currentAction == action) ? "active" : "";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mitfahrboerse</title>

    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Mitfahrboerse.styles.css" asp-append-version="true" />
</head>
<body class="@(selectedDesign == 1 ? "design-b" : "")">
    <header>
        <nav>
            <div class="header-content-wrapper">
                <div class="logo">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/f/fb/HTL_Waidhofen_Ybbs.png" alt="HTL Logo" />
                </div>
            </div>

            <button class="menu-toggle" id="menuToggle" aria-label="Menü öffnen/schließen">
                &#9776;
            </button>

            <div class="menu" id="mainMenu">
                <div class="menu-item">
                    <a class="@GetActive("Ride", "Index")" asp-controller="Ride" asp-action="Index">Mitfahren</a>
                </div>

                <div class="menu-item">
                    <a class="@GetActive("Ride", "Create")" asp-controller="Ride" asp-action="Create">Fahrt erstellen</a>
                </div>

                <div class="menu-item">
                    <a class="@GetActive("Requests", "Index")" asp-controller="Requests" asp-action="Index">Anfragen</a>
                </div>

                <div class="menu-item">
                    <a class="@GetActive("Shop", "Index")" asp-controller="Shop" asp-action="Index">Shop</a>
                </div>

                <div class="menu-item">
                    <a class="@GetActive("Profil", "Index")" asp-controller="Profil" asp-action="Index">Profil</a>
                </div>
            </div>
            <div class="coin-balance">
                <span>@coinBalance</span>
                <img src="https://images.vexels.com/media/users/3/130116/isolated/preview/215a871596b92451a1678e36960c0ab7-dollar-coin-icon.png" alt="Coins" />
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById('menuToggle').addEventListener('click', function() {
            var menu = document.getElementById('mainMenu');
            menu.classList.toggle('open');
        });
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
