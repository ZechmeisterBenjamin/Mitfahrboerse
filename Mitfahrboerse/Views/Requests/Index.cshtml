@model IEnumerable<Mitfahrboerse.Models.t_PersonRide>
<style>

    .anfragen-container {
        padding: 15px;
        display: flex;
        flex-direction: column;
    }

    .anfrage-item {
        background-color: #666;
        border-radius: 25px;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: white;
    }

        .anfrage-item.selected {
            border: 2px solid #b8b8ff;
        }

    .anfrage-info {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: center;
        font-size: 16px;
    }

        .anfrage-info .name {
            font-weight: bold;
            text-decoration: underline;
        }

        .anfrage-info .tag {
            font-weight: bold;
            text-decoration: underline;
        }

    .anfrage-actions {
        display: flex;
        gap: 10px;
    }

    .accept-btn,
    .reject-btn {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        border: none;
        font-size: 20px;
        font-weight: bold;
        cursor: pointer;
    }

    .accept-btn {
        background-color: #4caf50;
        color: white;
    }

    .reject-btn {
        background-color: #e53935;
        color: white;
    }

    .accept-btn:hover {
        background-color: #43a047;
    }

    .reject-btn:hover {
        background-color: #d32f2f;
    }

    .content-panel {
        flex: 1;
        background-color: #4d4d4d;
        border-radius: 20px;
        padding: 20px;
        color: white;
        margin-top: 50px;
        margin-bottom: 50px;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
    }
</style>
<div class="content-panel">
    <div class="anfragen-container" id="anfragenContainer">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                // Eindeutige ID für das Element hinzufügen, um es später zu entfernen
                <div class="anfrage-item" id="request-@item.FK_RideId-@item.FK_PersonId" style="margin-bottom: 10px; transition: all 0.4s ease;">
                    <div class="anfrage-info">
                        <span class="name">@item.Person.FirstName @item.Person.LastName</span>
                        <span class="tag">@item.Person.Class</span>
                        <span><strong>Von:</strong> @item.Ride.FK_StartsAt_Position.Description</span>
                        <span><strong>Nach:</strong> @item.Ride.FK_EndsAt_Position.Description</span>
                        <span><strong>Um:</strong> @item.Ride.RideDateTime.ToString("HH:mm")</span>
                    </div>

                    <div class="anfrage-actions">
                        <form onsubmit="handleRequestAction(event, @item.FK_RideId, '@item.FK_PersonId', 0)" style="display:inline;">
                            <button type="submit" class="accept-btn">✔</button>
                        </form>

                        <form onsubmit="handleRequestAction(event, @item.FK_RideId, '@item.FK_PersonId', 2)" style="display:inline;">
                            <button type="submit" class="reject-btn">✖</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div id="emptyMessage" style="text-align:center; padding: 20px; color: #ccc;">
                Keine offenen Anfragen vorhanden.
            </div>
        }
    </div>
</div>

<script>
    async function handleRequestAction(event, rideId, requesterId, newStatus) {
        event.preventDefault();

        const formData = new URLSearchParams();
        formData.append('rideId', rideId);
        formData.append('requesterId', requesterId);
        formData.append('newStatus', newStatus);

        try {
            const response = await fetch('@Url.Action("HandleAction", "Requests")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            });

            const result = await response.json();

            if (result.success) {
                const element = document.getElementById(`request-${rideId}-${requesterId}`);

                element.style.opacity = '0';
                element.style.transform = 'translateX(20px)';

                setTimeout(() => {
                    element.remove();

                    const container = document.getElementById('anfragenContainer');
                    if (container.querySelectorAll('.anfrage-item').length === 0) {
                        container.innerHTML = '<div id="emptyMessage" style="text-align:center; padding: 20px; color: #ccc;">Keine offenen Anfragen vorhanden.</div>';
                    }
                }, 400);
            } else {
                alert("Fehler: " + result.message);
            }
        } catch (error) {
            console.error("Fehler beim Senden:", error);
            alert("Ein technischer Fehler ist aufgetreten.");
        }
    }
</script>