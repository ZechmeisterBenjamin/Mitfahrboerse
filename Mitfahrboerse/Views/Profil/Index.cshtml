@{
    ViewData["Title"] = "Profil";
}

<html>
<head>
    <meta charset="utf-8"/>
    <title>HTL Waidhofen - Profil</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css"/>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <style>
        .settings-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding: 20px;
        }

        .setting-group {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .side-menu form {
            width: 100%;
        }

            .side-menu form .side-button.logout {
                width: 100%;
            }

        .design-options {
            display: flex;
            gap: 30px;
            margin-bottom: 20px;
        }

        .design-option {
            width: 150px;
            height: 100px;
            background-color: #7a7a7a;
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-weight: bold;
            font-size: 18px;
            cursor: pointer;
            border: 4px solid #cccccc;
            box-sizing: border-box;
        }

        .design-option.active-design {
            border: 4px solid #8e6cff;
        }

        .setting-label {
            font-size: 20px;
            text-decoration: underline;
            margin-right: 10px;
        }

        .setting-group select {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
            background-color: #ffffff;
            color: black;
            font-size: 16px;
        }

        .remove-button {
            background-color: #c93b3b;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            margin-left: 10px;
        }

        .statistics-container {
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .statistics-container h2 {
            margin-bottom: 20px;
        }

        .statistic-item {
            font-size: 18px;
        }

        .create-form-container {
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .create-form-container h2 {
            margin-bottom: 20px;
            text-align: center;
        }

        .form-group {
            display: flex;
            align-items: center;
            justify-content: flex-start; 
            gap: 30px; 
            font-size: 16px;
        }

            .form-group label {
                min-width: 120px;
                text-align: left;
            }

        .create-form-container input[type="text"] {
            flex-grow: 1;
            max-width: 300px;
            padding: 12px 10px;
            border-radius: 10px;
            border: none;
            font-size: 16px;
            background-color: white;
            box-sizing: border-box;
            color: black;
        }

        .create-form-container .styled-button {
            align-self: flex-start !important; 
        }

        .ride-list-container {
            padding: 20px;
        }

        .ride-list-container h2 {
            text-align: center;
        }

        .ride-list-group {
            margin-top: 30px;
            margin-bottom: 40px;
        }

            .ride-list-group h3 {
                font-size: 24px;
                text-decoration: underline;
                margin-bottom: 15px;
            }

            .ride-list-group ul {
                list-style-type: disc;
                padding-left: 40px;
            }

            .ride-list-group li {
                font-size: 16px;
                margin-bottom: 10px;
            }

            .ride-list-group a {
                color: white;
                text-decoration: underline;
            }
        .ride-list-group ul {
            list-style-type: disc;
            padding-left: 40px;
        }

        .ride-list-group li {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .ride-list-group a {
            color: white;
            text-decoration: underline;
        }
    </style>
</head>
<body>
<main class="main-container">
    <div class="side-menu" id="sideMenu">
        <button class="side-button active" data-content="settings">Einstellungen</button>
        <button class="side-button" data-content="check">Fahrten überprüfen</button>
        <button class="side-button" data-content="history">Fahrten Historie</button>
        <button class="side-button" data-content="create">Auto Erstellen</button>
        <button class="side-button" data-content="voucher">Gutscheine</button>
        <form asp-action="Logout" method="post">
            <button type="submit" class="side-button logout">Logout</button>
        </form>
    </div>

    <div class="content-panel" id="contentPanel">
    </div>
</main>


<script>
    const buttons = document.querySelectorAll('.side-button:not(.logout)');
    const contentPanel = document.getElementById('contentPanel');

    const settingsHTML = `
            <div class="settings-container">
                <h2 style="text-align: center;">Einstellungen</h2>

                <div style="margin-top: 10px;">
                    <span class="setting-label">Design:</span>
                    <div class="design-options">
                        <div class="design-option active-design" id="designA">Design A</div>
                        <div class="design-option" id="designB">Design B</div>
                    </div>
                </div>

                <div class="setting-group">
                    <span class="setting-label">Startseite:</span>
                    <select id="startseite">
                        <option value="#" selected>Mitfahren</option>
                        <option value="#">Fahrt Erstellen</option>
                    </select>
                </div>

                <div class="setting-group">
                    <span class="setting-label">Autos:</span>
                    <select id="autos">
                        <option value="auto1" selected>Auto 1</option>
                        <option value="auto2">Auto 2</option>
                        <option value="auto3">Auto 3</option>
                    </select>
                    <button class="remove-button">Entfernen</button>
                </div>
            </div>
        `;

    const statisticsHTML = `
            <div class="statistics-container">
                <h2>Fahrten Statistik</h2>

                <div class="statistic-item">
                    Fahrten gesamt: 5
                </div>

                <div class="statistic-item">
                    Gesamt gefahrene Kilometer: 100km
                </div>

                <div class="statistic-item">
                    So oft mitgefahren: 0
                </div>

                <div class="statistic-item">
                    Gesamt Anzahl Passagiere: 10
                </div>
            </div>
        `;

    const checkRidesHTML = `
            <div class="ride-list-container">
                <h2>Fahrten überprüfen</h2>

                <div class="ride-list-group">
                    <h3>Meine Fahrten:</h3>
                    <ul>
                        <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                        <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                    </ul>
                </div>

                <div class="ride-list-group">
                    <h3>Mitfahren:</h3>
                    <ul>
                        <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                        <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                    </ul>
                </div>
            </div>
        `;


    const createCarHTML = `
            <form class="create-form-container" method="post" action="@Url.Action("CreateCar", "Profil")">
            <div class="create-form-container">
                <h2>Auto erstellen</h2>

                <div class="form-group">
                    <label for="kennzeichen">Kennzeichen:</label>
                    <input type="text" id="kennzeichen" name="kennzeichen" />
                </div>

                <div class="form-group">
                    <label for="sitze">Sitzplätze:</label>
                    <input type="text" id="sitze" name="sitze" />
                </div>

                <div class="form-group">
                    <label for="marke">Marke:</label>
                    <input type="text" id="marke" name="marke" />
                </div>

                <div class="form-group">
                    <label for="modell">Modell:</label>
                    <input type="text" id="modell" name="modell" />
                </div>

                <div class="form-group">
                    <label for="farbe">Farbe:</label>
                    <input type="text" id="farbe" name="farbe" />
                </div>

                <button type="submit" class="styled-button" style="max-width: 450px; margin-top: 20px; align-self: flex-start;">Auto speichern</button>
            </div>
            </form>
        `;

        const showVoucherHTML = `
                <div class="voucher-list-container">
                    <h2>Deine Gutscheine</h2>

                    <div class="ride-list-group">
                        <h3>Meine Fahrten:</h3>
                        <ul>
                            <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                            <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                        </ul>
                    </div>

                    <div class="ride-list-group">
                        <h3>Mitfahren:</h3>
                        <ul>
                            <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                            <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                        </ul>
                    </div>
                </div>
        `;


    const contentData = {
        settings: settingsHTML,
        check: checkRidesHTML,
        history: statisticsHTML,
        create: createCarHTML,
        voucher: showVoucherHTML
    };

    contentPanel.innerHTML = contentData.settings;


    buttons.forEach(button => {
        button.addEventListener('click', () => {
            buttons.forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');

            const contentKey = button.getAttribute('data-content');
            contentPanel.innerHTML = contentData[contentKey];
        });
    });
</script>
</body>
</html>