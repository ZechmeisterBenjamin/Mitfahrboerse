@{
    ViewData["Title"] = "Profil";
    int coinBalance = 100;
}

<html>
<head>
    <meta charset="utf-8" />
    <title>HTL Waidhofen - Profil</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <style>
        .settings-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding: 20px;
        }

        .setting-group {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .design-options {
            display: flex;
            gap: 30px;
            margin-bottom: 20px; 
        }

        .design-option {
            width: 150px;
            height: 100px;
            background-color: #7a7a7a; 
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-weight: bold;
            font-size: 18px;
            cursor: pointer;
            border: 4px solid #cccccc; 
            box-sizing: border-box; 
        }

            .design-option.active-design {
                border: 4px solid #8e6cff; 
            }

        .setting-label {
            font-size: 20px;
            text-decoration: underline;
            margin-right: 10px;
        }

        .setting-group select {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
            background-color: #ffffff;
            color: black;
            font-size: 16px;
        }

        .remove-button {
            background-color: #c93b3b;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            margin-left: 10px;
        }
    </style>
</head>
    <main class="main-container">
        <div class="side-menu" id="sideMenu">
            <button class="side-button active" data-content="settings">Einstellungen</button>
            <button class="side-button" data-content="check">Fahrten überprüfen</button>
            <button class="side-button" data-content="history">Fahrten Historie</button>
            <button class="side-button" data-content="create">Auto Erstellen</button>
            <form asp-action="Logout" method="post">
                <button type="submit" class="side-button logout">Logout</button>
            </form>
        </div>

        <div class="content-panel" id="contentPanel">
        </div>
    </main>


    <script>
        const buttons = document.querySelectorAll('.side-button:not(.logout)');
        const contentPanel = document.getElementById('contentPanel');

        const contentData = {
            settings: `
        <div class="settings-container">
            <h2 style="text-align: center;">Einstellungen</h2>

            <div style="margin-top: 10px;">
                <span class="setting-label">Design:</span>
                <div class="design-options">
                    <div class="design-option active-design" id="designA">Design A</div>
                    <div class="design-option" id="designB">Design B</div>
                </div>
            </div>

            <div class="setting-group">
                <span class="setting-label">Startseite:</span>
                <select id="startseite">
                    <option value="#" selected>Mitfahren</option>
                    <option value="#">Fahrt Erstellen</option>
                </select>
            </div>

            <div class="setting-group">
                <span class="setting-label">Autos:</span>
                <select id="autos">
                    <option value="auto1" selected>Auto 1</option>
                    <option value="auto2">Auto 2</option>
                    <option value="auto3">Auto 3</option>
                </select>
                <button class="remove-button">Entfernen</button>
            </div>
        </div>
            `,
            check: `
            `,
            history: `
            `,
            create: `
            `
        };

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                buttons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');

                const contentKey = button.getAttribute('data-content');
                contentPanel.innerHTML = contentData[contentKey];
            });
        });
    </script>
</html>
