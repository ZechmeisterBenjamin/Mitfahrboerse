@{
    ViewData["Title"] = "Profil";
    int coinBalance = 100;
}

<html>
<head>
    <meta charset="utf-8" />
    <title>HTL Waidhofen - Profil</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
    <main class="main-container">
        <div class="side-menu" id="sideMenu">
            <button class="side-button active" data-content="settings">Einstellungen</button>
            <button class="side-button" data-content="check">Fahrten überprüfen</button>
            <button class="side-button" data-content="history">Fahrten Historie</button>
            <button class="side-button" data-content="create">Auto Erstellen</button>
            <form asp-action="Logout" method="post">
                <button type="submit" class="side-button logout">Logout</button>
            </form>
        </div>

        <div class="content-panel" id="contentPanel">
        </div>
    </main>


    <script>
        const buttons = document.querySelectorAll('.side-button:not(.logout)');
        const contentPanel = document.getElementById('contentPanel');

        const settingsHTML = `
            <div class="settings-container">
                <h2>Einstellungen</h2>

                <div class="design-wrapper">
                    <span class="setting-label">Design:</span>
                    <div class="design-options">
                        <div class="design-option active-design" id="designA">Design A</div>
                        <div class="design-option" id="designB">Design B</div>
                    </div>
                </div>

                <div class="setting-group">
                    <span class="setting-label">Startseite:</span>
                    <select id="startseite">
                        <option value="#" selected>Mitfahren</option>
                        <option value="#">Fahrt Erstellen</option>
                    </select>
                </div>

                <div class="setting-group">
                    <span class="setting-label">Autos:</span>
                    <select id="autos">
                        <option value="auto1" selected>Auto 1</option>
                        <option value="auto2">Auto 2</option>
                        <option value="auto3">Auto 3</option>
                    </select>
                    <button class="remove-button">Entfernen</button>
                </div>
            </div>
        `;

        const statisticsHTML = `
            <div class="statistics-container">
                <h2>Fahrten Statistik</h2>

                <div class="statistic-item">
                    Fahrten gesamt: 5
                </div>

                <div class="statistic-item">
                    Gesamt gefahrene Kilometer: 100km
                </div>

                <div class="statistic-item">
                    So oft mitgefahren: 0
                </div>

                <div class="statistic-item">
                    Gesamt Anzahl Passagiere: 10
                </div>
            </div>
        `;

        const checkRidesHTML = `
            <div class="ride-list-container">
                <h2>Fahrten überprüfen</h2>

                <div class="ride-list-group">
                    <h3>Meine Fahrten:</h3>
                    <ul>
                        <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                        <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                    </ul>
                </div>

                <div class="ride-list-group">
                    <h3>Mitfahren:</h3>
                    <ul>
                        <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                        <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                    </ul>
                </div>
            </div>
        `;


        const createCarHTML = `
            <div class="create-form-container">
                <h2>Auto erstellen</h2>

                <div class="form-group">
                    <label for="kennzeichen">Kennzeichen:</label>
                    <input type="text" id="kennzeichen" name="kennzeichen" />
                </div>

                <div class="form-group">
                    <label for="sitze">Sitzplätze:</label>
                    <input type="text" id="sitze" name="sitze" />
                </div>

                <div class="form-group">
                    <label for="marke">Marke:</label>
                    <input type="text" id="marke" name="marke" />
                </div>

                <div class="form-group">
                    <label for="modell">Modell:</label>
                    <input type="text" id="modell" name="modell" />
                </div>

                <div class="form-group">
                    <label for="farbe">Farbe:</label>
                    <input type="text" id="farbe" name="farbe" />
                </div>

                <button class="styled-button create-car-button">Auto speichern</button>
            </div>
        `;


        const contentData = {
            settings: settingsHTML,
            check: checkRidesHTML,
            history: statisticsHTML,
            create: createCarHTML
        };

        contentPanel.innerHTML = contentData.settings;


        buttons.forEach(button => {
            button.addEventListener('click', () => {
                buttons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');

                const contentKey = button.getAttribute('data-content');
                contentPanel.innerHTML = contentData[contentKey];
            });
        });
    </script>
</body>
</html>