@model Mitfahrboerse.Models.t_Person
@{
    ViewData["Title"] = "Profil";
    int ridesSum = (int)(ViewData["RidesSum"] ?? 0);
    double distance = (double)(ViewData["Distance"] ?? 0.0);
    int joinedRidesSum = (int)(ViewData["JoinedRidesSum"] ?? 0);
    int distinctPassengersSum = (int)(ViewData["DistinctPassengersSum"] ?? 0);
    int selectedDesign = Convert.ToInt32(ViewData["SelectedDesign"] ?? 0);
    int selectedStartseite = Convert.ToInt32(ViewData["SelectedStartseite"] ?? 0);
    var cars = Model.t_Cars;
    var hasCars = cars != null && cars.Any(); string carDeleteError = TempData["CarDeleteError"] as string ?? "";
    string carDeleteSuccess = TempData["CarDeleteSuccess"] as string ?? "";
}

<html>
<head>
    <meta charset="utf-8" />
    <title>HTL Waidhofen - Profil</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <main class="main-container">
        <div class="side-menu" id="sideMenu">
            <button class="side-button active" data-content="settings">Einstellungen</button>
            <button class="side-button" data-content="check">Fahrten überprüfen</button>
            <button class="side-button" data-content="history">Statistiken</button>
            <button class="side-button" data-content="create">Auto Erstellen</button>
            <button class="side-button" data-content="voucher">Gutscheine</button>
            <form asp-action="Logout" method="post">
                <button type="submit" class="side-button logout">Logout</button>
            </form>
        </div>

        <div class="content-panel" id="contentPanel">
        </div>
    </main>

    <script>
        const buttons = document.querySelectorAll('.side-button:not(.logout)');
        const contentPanel = document.getElementById('contentPanel');

        let currentSettings = {
            selectedDesign: @selectedDesign,
            selectedStartseite: @selectedStartseite
        };

        function updateSettings() {
            fetch('@Url.Action("UpdateSettings", "Profil")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(currentSettings)
            });
        }

        function applyDesignClass() {
            document.body.classList.toggle('design-b', currentSettings.selectedDesign === 1);
        }

        const settingsHTML = `
                <div class="settings-container">
                    <h2>Einstellungen</h2>
                    @if (!string.IsNullOrEmpty(carDeleteError))
                    {
                        <div class="alert-message alert-error">@carDeleteError</div>
                    }
                    @if (!string.IsNullOrEmpty(carDeleteSuccess))
                    {
                        <div class="alert-message alert-success">@carDeleteSuccess</div>
                    }

                    <div class="settings-section">
                        <span class="settings-section-title">Design-Modus</span>
                        <div class="design-options">
                            <div class="design-option ${currentSettings.selectedDesign === 0 ? 'active-design' : ''}" data-design="0">Light Mode</div>
                            <div class="design-option ${currentSettings.selectedDesign === 1 ? 'active-design' : ''}" data-design="1">Dark Mode</div>
                        </div>
                    </div>

                    <div class="setting-group">
                        <span class="setting-label">Startseite</span>
                        <select id="startseite">
                            <option value="0" ${currentSettings.selectedStartseite === 0 ? 'selected' : ''}>Mitfahren</option>
                            <option value="1" ${currentSettings.selectedStartseite === 1 ? 'selected' : ''}>Fahrt Erstellen</option>
                        </select>
                    </div>

                <div class="setting-group">
                        <span class="setting-label">Meine Autos</span>
                        <form method="post" action="@Url.Action("DeleteCar", "Profil")" style="width: 100%; display: flex; flex-direction: column; gap: 15px;">
                            <select id="autos" name="carId" @(hasCars ? "" : "disabled")>
                                @if (hasCars)
                                {
                                    @foreach (var car in cars)
                                    {
                                        <option value="@car.CarId">@car.Brand @car.Model (@car.LicensePlate)</option>
                                    }
                                }
                                else
                                {
                                    <option value="">Keine Autos vorhanden</option>
                                }
                            </select>
                            <button type="submit" class="remove-button" onclick="return confirm('Auto wirklich entfernen?');" @(hasCars ? "" : "disabled")>
                                Auto entfernen
                            </button>
                        </form>
                    </div>
                </div>
            `;

        const statisticsHTML = `
                <div class="statistics-container">
                    <h2>Fahrten-Statistik</h2>
                    <div class="statistic-item"><strong>Fahrten als Fahrer:</strong><br>@ridesSum Fahrten insgesamt</div>
                    <div class="statistic-item"><strong>Gefahrene Kilometer:</strong><br>@distance.ToString("F1") km</div>
                    <div class="statistic-item"><strong>Mitgefahren:</strong><br>@joinedRidesSum mal als Passagier</div>
                    <div class="statistic-item"><strong>Passagiere befördert:</strong><br>@distinctPassengersSum verschiedene Personen</div>
                </div>
            `;

        const checkRidesHTML = `
                <div class="ride-list-container">
                    <h2>Fahrten überprüfen</h2>
                    <div class="ride-list-group">
                        <h3>Meine Fahrten (als Fahrer)</h3>
                        @if (Model?.t_Rides != null && Model.t_Rides.Any())
                        {
                                @foreach (var ride in Model.t_Rides)
                                {
                                        var count = ride.PersonRides?.Count(x => x.Status == 1) ?? 0;
                                        <div class="ride-item">
                                            <div>
                                                <div class="ride-item-date">@ride.RideDateTime.ToString("dd.MM.yyyy HH:mm") Uhr</div>
                                                <div class="ride-item-route">
                                                    <span>@(ride.FK_StartsAt_Position?.Description ?? "Unbekannt")</span>
                                                    <span class="arrow">→</span>
                                                    <span>@(ride.FK_EndsAt_Position?.Description ?? "Unbekannt")</span>
                                                </div>
                                            </div>
                                            <div class="ride-item-badge">@count Mitfahrer</div>
                                        </div>
                                }
                        }
                        else
                        {
                                <p>Keine Fahrten erstellt.</p>
                            }
                    </div>

                    <div class="ride-list-group">
                        <h3>Mitfahrten (als Passagier)</h3>
                        @if (Model?.PersonRides != null && Model.PersonRides.Any())
                        {
                                @foreach (var pr in Model.PersonRides)
                                {
                                        <div class="ride-item">
                                            <div>
                                                <div class="ride-item-date">@(pr.Ride?.RideDateTime.ToString("dd.MM.yyyy HH:mm") ?? "---") Uhr</div>
                                                <div class="ride-item-route">
                                                    <span>@(pr.Ride?.FK_StartsAt_Position?.Description ?? "Unbekannt")</span>
                                                    <span class="arrow">→</span>
                                                    <span>@(pr.Ride?.FK_EndsAt_Position?.Description ?? "Unbekannt")</span>
                                                </div>
                                            </div>
                                            <span class="status-badge @(pr.Status == 1 ? "accepted" : (pr.Status == 2 ? "rejected" : "pending"))">
                                                @(pr.Status == 1 ? "Angenommen" : (pr.Status == 2 ? "Abgelehnt" : "Offen"))
                                            </span>
                                        </div>
                                }
                        }
                        else
                        {
                                <p>Keine Mitfahrten.</p>
                            }
                    </div>
                </div>
            `;

        const createCarHTML = `
                <form class="create-form-container" method="post" action="@Url.Action("CreateCar", "Profil")">
                    <h2>Neues Auto erstellen</h2>
                    <div class="form-group"><label>Kennzeichen:</label><input type="text" name="kennzeichen" required /></div>
                    <div class="form-group"><label>Sitzplätze:</label><input type="number" name="sitze" min="1" max="9" required /></div>
                    <div class="form-group"><label>Marke:</label><input type="text" name="marke" required /></div>
                    <div class="form-group"><label>Modell:</label><input type="text" name="modell" required /></div>
                    <div class="form-group"><label>Farbe:</label><input type="text" name="farbe" required /></div>
                    <button type="submit" class="styled-button primary-button">Auto speichern</button>
                </form>
            `;

        const showVoucherHTML = `
                <div class="voucher-section">
                    <div class="voucher-list-panel">
                        <h2>Deine Gutscheine</h2>
                            @if (Model?.PersonOffers != null && Model.PersonOffers.Any())
                            {
                                @foreach (var v in Model.PersonOffers)
                                {
                                    <div class="voucher-card" onclick="showVoucherDetails('@v.Code', '@(v.FK_Offer?.Title ?? "Gutschein")', '@v.FK_ValidUntil')">
                                        <label>@(v.FK_Offer?.Title ?? "Gutschein")</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p>Noch keine Gutscheine vorhanden.</p>
                            }
                    </div>
                    <div class="voucher-detail-panel" id="voucherDetailPanel">Wähle einen Gutschein aus.</div>
                </div>
            `;

        const contentData = {
            settings: settingsHTML,
            check: checkRidesHTML,
            history: statisticsHTML,
            create: createCarHTML,
            voucher: showVoucherHTML
        };

        contentPanel.innerHTML = contentData.settings;

        function attachSettingsListeners() {
            const designOptions = document.querySelectorAll('.design-option');
            designOptions.forEach(option => {
                option.addEventListener('click', () => {
                    currentSettings.selectedDesign = parseInt(option.getAttribute('data-design'));
                    updateSettings();
                    applyDesignClass();
                    contentPanel.innerHTML = settingsHTML; // Refresh to show active class
                    attachSettingsListeners();
                });
            });
            const startseitSelect = document.getElementById('startseite');
            if (startseitSelect) {
                startseitSelect.addEventListener('change', (e) => {
                    currentSettings.selectedStartseite = parseInt(e.target.value);
                    updateSettings();
                });
            }
        }

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                buttons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                const contentKey = button.getAttribute('data-content');
                contentPanel.innerHTML = contentData[contentKey];
                if (contentKey === 'settings') attachSettingsListeners();
            });
        });

        attachSettingsListeners();
        applyDesignClass();

        function showVoucherDetails(code, title, validUntil) {
            document.getElementById('voucherDetailPanel').innerHTML = `
                <div class="voucher-detail-card">
                    <h3>${title}</h3>
                    <p><strong>Code:</strong> <code class="voucher-code">${code}</code></p>
                    <p><strong>Gültig bis:</strong> ${validUntil}</p>
                </div>`;
        }
    </script>
</body>
</html>