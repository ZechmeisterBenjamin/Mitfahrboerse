@model Mitfahrboerse.Models.t_Person
@{
    ViewData["Title"] = "Profil";
    int ridesSum = (int)(ViewData["RidesSum"] ?? 0);
    double distance = (double)(ViewData["Distance"] ?? 0.0);
    int joinedRidesSum = (int)(ViewData["JoinedRidesSum"] ?? 0);
    int distinctPassengersSum = (int)(ViewData["DistinctPassengersSum"] ?? 0);
    int selectedDesign = Convert.ToInt32(ViewData["SelectedDesign"] ?? 0);
    int selectedStartseite = Convert.ToInt32(ViewData["SelectedStartseite"] ?? 0);
    var cars = ViewData["Cars"] as List<t_Car> ?? new List<t_Car>();
    bool hasCars = cars.Count > 0;
    string carDeleteError = TempData["CarDeleteError"] as string ?? "";
    string carDeleteSuccess = TempData["CarDeleteSuccess"] as string ?? "";
}

<html>
<head>
    <meta charset="utf-8"/>
    <title>HTL Waidhofen - Profil</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <style>
        .settings-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding: 20px;
        }

        .setting-group {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .side-menu form {
            width: 100%;
        }

            .side-menu form .side-button.logout {
                width: 100%;
            }

        .design-options {
            display: flex;
            gap: 30px;
            margin-bottom: 20px;
        }

        .design-option {
            width: 150px;
            height: 100px;
            background-color: #7a7a7a;
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-weight: bold;
            font-size: 18px;
            cursor: pointer;
            border: 4px solid #cccccc;
            box-sizing: border-box;
        }

        .design-option.active-design {
            border: 4px solid #8e6cff;
        }

        .setting-label {
            font-size: 20px;
            text-decoration: underline;
            margin-right: 10px;
        }

        .setting-group select {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
            background-color: #ffffff;
            color: black;
            font-size: 16px;
        }

        .remove-button {
            background-color: #c93b3b;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            margin-left: 10px;
        }

        .statistics-container {
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .statistics-container h2 {
            margin-bottom: 20px;
        }

        .statistic-item {
            font-size: 18px;
        }

        .create-form-container {
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .create-form-container h2 {
            margin-bottom: 20px;
            text-align: center;
        }

        .form-group {
            display: flex;
            align-items: center;
            justify-content: flex-start; 
            gap: 30px; 
            font-size: 16px;
        }

            .form-group label {
                min-width: 120px;
                text-align: left;
            }

        .create-form-container input[type="text"] {
            flex-grow: 1;
            max-width: 300px;
            padding: 12px 10px;
            border-radius: 10px;
            border: none;
            font-size: 16px;
            background-color: white;
            box-sizing: border-box;
            color: black;
        }

        .create-form-container .styled-button {
            align-self: flex-start !important; 
        }

        .ride-list-container {
            padding: 20px;
        }

        .ride-list-container h2 {
            text-align: center;
        }

        .ride-list-group {
            margin-top: 30px;
            margin-bottom: 40px;
        }

            .ride-list-group h3 {
                font-size: 24px;
                text-decoration: underline;
                margin-bottom: 15px;
            }

            .ride-list-group ul {
                list-style-type: disc;
                padding-left: 40px;
            }

            .ride-list-group li {
                font-size: 16px;
                margin-bottom: 10px;
            }

            .ride-list-group a {
                color: white;
                text-decoration: underline;
            }
        .ride-list-group ul {
            list-style-type: disc;
            padding-left: 40px;
        }

        .ride-list-group li {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .ride-list-group a {
            color: white;
            text-decoration: underline;
        }
    </style>
</head>
<body>
<main class="main-container">
    <div class="side-menu" id="sideMenu">
        <button class="side-button active" data-content="settings">Einstellungen</button>
        <button class="side-button" data-content="check">Fahrten überprüfen</button>
        <button class="side-button" data-content="history">Fahrten Historie</button>
        <button class="side-button" data-content="create">Auto Erstellen</button>
        <button class="side-button" data-content="voucher">Gutscheine</button>
        <form asp-action="Logout" method="post">
            <button type="submit" class="side-button logout">Logout</button>
        </form>
    </div>

    <div class="content-panel" id="contentPanel">
    </div>
</main>


<script>
    const buttons = document.querySelectorAll('.side-button:not(.logout)');
    const contentPanel = document.getElementById('contentPanel');

    // Store settings state
    let currentSettings = {
        selectedDesign: @selectedDesign,
        selectedStartseite: @selectedStartseite
    };

    function updateSettings() {
        fetch('@Url.Action("UpdateSettings", "Profil")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(currentSettings)
        })
        .then(response => response.json())
        .then(data => {
            console.log('Settings updated:', data);
        })
        .catch(error => {
            console.error('Error updating settings:', error);
        });
    }

    function applyDesignClass() {
        document.body.classList.toggle('design-b', currentSettings.selectedDesign === 1);
    }

    const settingsHTML = `
            <div class="settings-container">
                <h2 style="text-align: center;">Einstellungen</h2>

                @if (!string.IsNullOrEmpty(carDeleteError))
                {
                    <div style="color: #c93b3b; font-weight: bold; text-align: center;">@carDeleteError</div>
                }
                @if (!string.IsNullOrEmpty(carDeleteSuccess))
                {
                    <div style="color: #2b8a3e; font-weight: bold; text-align: center;">@carDeleteSuccess</div>
                }

                <div style="margin-top: 10px;">
                    <span class="setting-label">Design:</span>
                    <div class="design-options">
                        <div class="design-option ${currentSettings.selectedDesign === 0 ? 'active-design' : ''}" id="designA" data-design="0">Light Mode</div>
                        <div class="design-option ${currentSettings.selectedDesign === 1 ? 'active-design' : ''}" id="designB" data-design="1">Dark Mode</div>
                    </div>
                </div>

                <div class="setting-group">
                    <span class="setting-label">Startseite:</span>
                    <select id="startseite">
                        <option value="0" ${currentSettings.selectedStartseite === 0 ? 'selected' : ''}>Mitfahren</option>
                        <option value="1" ${currentSettings.selectedStartseite === 1 ? 'selected' : ''}>Fahrt Erstellen</option>
                    </select>
                </div>

                <div class="setting-group">
                    <span class="setting-label">Autos:</span>
                    <form method="post" action="@Url.Action("DeleteCar", "Profil")">
                        <select id="autos" name="carId" @(hasCars ? "" : "disabled")>
                            @if (hasCars)
                            {
                                foreach (var car in cars)
                                {
                                    <option value="@car.CarId">@car.Brand @car.Model (@car.LicensePlate)</option>
                                }
                            }
                            else
                            {
                                <option value="">Keine Autos vorhanden</option>
                            }
                        </select>
                        <button class="remove-button" onclick="return confirm('Auto wirklich entfernen?');" @(hasCars ? "" : "disabled")>Entfernen</button>
                    </form>
                </div>
            </div>
        `;

    const statisticsHTML = `
            <div class="statistics-container">
                <h2>Fahrten Statistik</h2>

                <div class="statistic-item">
                    Fahrten gesamt: 5
                </div>

                <div class="statistic-item">
                    Gesamt gefahrene Kilometer: 100km
                </div>

                <div class="statistic-item">
                    So oft mitgefahren: 0
                </div>

                <div class="statistic-item">
                    Gesamt Anzahl Passagiere: 10
                </div>
            </div>
        `;

    const checkRidesHTML = `
            <div class="ride-list-container">
                <h2>Fahrten überprüfen</h2>

                <div class="ride-list-group">
                    <h3>Meine Fahrten:</h3>
                    <ul>
                        <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                        <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                    </ul>
                </div>

                <div class="ride-list-group">
                    <h3>Mitfahren:</h3>
                    <ul>
                        <li><a href="#">1.9.2025 5:00 Uhr von Gresten nach HTL Waidhofen/Ybbs</a></li>
                        <li><a href="#">1.9.2025 9:00 Uhr von HTL Waidhofen/Ybbs nach Gresten</a></li>
                    </ul>
                </div>
            </div>
        `;


    const createCarHTML = `
            <form class="create-form-container" method="post" action="@Url.Action("CreateCar", "Profil")">
            <div class="create-form-container">
                <h2>Auto erstellen</h2>

                <div class="form-group">
                    <label for="kennzeichen">Kennzeichen:</label>
                    <input type="text" id="kennzeichen" name="kennzeichen" />
                </div>

                <div class="form-group">
                    <label for="sitze">Sitzplätze:</label>
                    <input type="text" id="sitze" name="sitze" />
                </div>

                <div class="form-group">
                    <label for="marke">Marke:</label>
                    <input type="text" id="marke" name="marke" />
                </div>

                <div class="form-group">
                    <label for="modell">Modell:</label>
                    <input type="text" id="modell" name="modell" />
                </div>

                <div class="form-group">
                    <label for="farbe">Farbe:</label>
                    <input type="text" id="farbe" name="farbe" />
                </div>

                <button type="submit" class="styled-button" style="max-width: 450px; margin-top: 20px; align-self: flex-start;">Auto speichern</button>
            </div>
            </form>
        `;

    const showVoucherHTML = `
            <div style="display: flex; gap: 20px; padding: 20px; height: 100%; color: white;">

                <div style="flex: 1; border-right: 1px solid #555; padding-right: 20px;">
                    <h2 style="text-decoration: underline; margin-bottom: 20px;">Deine Gutscheine</h2>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @if (Model != null && Model.PersonOffers != null && Model.PersonOffers.Any())
                        {
                            @foreach (var v in Model.PersonOffers)
                            {
                                <div onclick="showVoucherDetails('@v.Code', '@(v.FK_Offer?.Title ?? "Gutschein")', '@v.FK_ValidUntil')"
                                        style="background-color: #4a4a4a; padding: 15px; border-radius: 12px; cursor: pointer; transition: background 0.3s;"
                                        onmouseover="this.style.backgroundColor='#5a5a5a'"
                                        onmouseout="this.style.backgroundColor='#4a4a4a'">
                                    <label style="font-size: 1.1rem;">@(v.FK_Offer?.Title ?? "Gutschein")</label>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: #ccc;">Noch keine Gutscheine vorhanden.</p>
                        }
                    </div>
                </div>

                <div id="voucherDetailPanel" style="flex: 1.5; padding-left: 20px; display: flex; align-items: flex-start; justify-content: center;">
                    <div style="color: #888; border: 2px dashed #444; border-radius: 20px; padding: 40px; text-align: center; width: 100%;">
                        Wähle einen Gutschein aus, um Details anzuzeigen.
                    </div>
                </div>
            </div>
        `;


    const contentData = {
        settings: settingsHTML,
        check: checkRidesHTML,
        history: statisticsHTML,
        create: createCarHTML,
        voucher: showVoucherHTML
    };

    contentPanel.innerHTML = contentData.settings;


    function attachSettingsListeners() {
        // Design option listeners
        const designOptions = document.querySelectorAll('.design-option');
        designOptions.forEach(option => {
            option.addEventListener('click', () => {
                designOptions.forEach(opt => opt.classList.remove('active-design'));
                option.classList.add('active-design');
                currentSettings.selectedDesign = parseInt(option.getAttribute('data-design'));
                updateSettings();
                applyDesignClass();
            });
        });

        // Startseite dropdown listener
        const startseitSelect = document.getElementById('startseite');
        if (startseitSelect) {
            startseitSelect.addEventListener('change', (e) => {
                currentSettings.selectedStartseite = parseInt(e.target.value);
                updateSettings();
            });
        }
    }

    buttons.forEach(button => {
        button.addEventListener('click', () => {
            buttons.forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');

            const contentKey = button.getAttribute('data-content');
            contentPanel.innerHTML = contentData[contentKey];

            // Attach listeners if settings page is loaded
            if (contentKey === 'settings') {
                attachSettingsListeners();
            }
        });
    });

    // Attach listeners on initial page load (settings is default)
    attachSettingsListeners();
    applyDesignClass();

    function showVoucherDetails(code, title, validUntil) {
        const detailPanel = document.getElementById('voucherDetailPanel');

        detailPanel.innerHTML = `
            <div style="background-color: #4a4a4a; color: white; border-radius: 20px; padding: 25px; width: 100%; max-width: 450px; box-shadow: 0 4px 15px rgba(0,0,0,0.4); text-align: left;">
                <h3 style="margin-top: 0; color: #b2b2ff; font-size: 1.5rem; border-bottom: 1px solid #555; padding-bottom: 10px;">
                    ${title}
                </h3>
                <div style="margin: 20px 0;">
                    <p style="margin-bottom: 5px; color: #ccc; font-size: 0.9rem;">Gutscheincode:</p>
                    <code style="font-size: 1.4rem; color: #00ff00; background: #222; padding: 5px 10px; border-radius: 8px; display: block; font-family: monospace;">
                        ${code}
                    </code>
                </div>
                <div style="margin-top: 20px; font-size: 0.9rem; color: #aaa;">
                    <strong>Gültig bis:</strong><br>
                    ${validUntil}
                </div>
            </div>
        `;
    }
</script>
</body>
</html>
