@model IEnumerable<Mitfahrboerse.Models.t_Offer>
@{
    ViewData["Title"] = "Shop";
    int coinBalance = 0;
    var firstOffer = Model.FirstOrDefault();
    var initialTitle = firstOffer?.Title ?? "Kein Gutschein ausgewählt";
    var initialDate = firstOffer?.ValidUntil.ToString("d. MMMM yyyy") ?? "";
    var currentTime = DateTime.Now.ToString("HH:mm");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>HTL Waidhofen - Mitfahren</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #a5a5a5;
            overflow: hidden;
        }

        header {
            background-color: #cfe2ff;
            display: flex;
            align-items: center;
            padding: 10px 30px;
        }

        .logo {
            display: flex;
            align-items: center;
        }

            .logo img {
                height: 90px;
                margin-right: 10px;
            }

        .menu {
            display: flex;
            gap: 30px;
            align-items: center;
            margin-left: 30px;
        }

        .menu-item {
            text-align: center;
            cursor: pointer;
        }

        .coin-balance {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

            .coin-balance img {
                height: 50px;
            }

        .shop-container {
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .voucher-list {
            background-color: #4d4d4d;
            padding: 10px;
            border-radius: 20px;
            width: 250px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .voucher-item {
            background-color: #7a7a7a;
            padding: 15px;
            text-align: center;
            border-radius: 15px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            border: 2px solid transparent;
        }

            .voucher-item.selected {
                border: 2px solid #b8b8ff;
            }

        .voucher-details {
            background-color: #4d4d4d;
            padding: 20px;
            border-radius: 20px;
            flex: 1;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .voucher-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

            .voucher-header span {
                font-size: 1.1em;
            }

        .buy-button {
            background-color: #7a7a7a;
            padding: 10px 20px;
            border: none;
            border-radius: 20px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            align-self: center;
        }

            .buy-button:hover {
                background-color: #999;
            }
    </style>
</head>
<body>
    <main class="shop-container">
        <div class="voucher-list" id="voucherList">
            @foreach (var offer in Model)
            {   
            <div class="voucher-item @(offer == firstOffer ? "selected" : "")"
                 data-title="@offer.Title"
                 data-date="@offer.ValidUntil.ToString("d. MMMM yyyy")"
                 data-price="@offer.Price">
                @offer.Title<br>@offer.Price pkt
            </div>
            }
        </div>

        <div class="voucher-details" id="voucherDetails">
            <div class="voucher-header">
                <span id="voucherTitle">@initialTitle</span>
                <span id="voucherTime">@currentTime</span>
                <span id="voucherDate">@initialDate</span>
            </div>
            <button class="buy-button" id="buyButton">Gutschein kaufen</button>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const voucherItems = document.querySelectorAll('.voucher-item');
            const voucherTitle = document.getElementById('voucherTitle');
            const voucherDate = document.getElementById('voucherDate');
            const buyButton = document.getElementById('buyButton');
            let selectedPrice = @(firstOffer?.Price ?? 0);

            voucherItems.forEach(item => {
                item.addEventListener('click', function() {
                    voucherItems.forEach(vItem => vItem.classList.remove('selected'));
                    this.classList.add('selected');
                    
                    voucherTitle.textContent = this.getAttribute('data-title');
                    voucherDate.textContent = this.getAttribute('data-date');
                    selectedPrice = parseInt(this.getAttribute('data-price'));
                    
                    buyButton.textContent = `Gutschein kaufen (${selectedPrice} pkt)`;
                });
            });

            if (@(firstOffer != null ? "true" : "false")) {
                buyButton.textContent = `Gutschein kaufen (${selectedPrice} pkt)`;
            }
        });
    </script>
</body>
</html>