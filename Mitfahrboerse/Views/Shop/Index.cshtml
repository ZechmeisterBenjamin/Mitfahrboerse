@{
    int coinBalance = 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>HTL Waidhofen - Mitfahren</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #a5a5a5;
            overflow: hidden;
        }

        header {
            background-color: #cfe2ff;
            display: flex;
            align-items: center;
            padding: 10px 30px;
        }

        .logo {
            display: flex;
            align-items: center;
        }

            .logo img {
                height: 90px;
                margin-right: 10px;
            }

        .menu {
            display: flex;
            gap: 30px;
            align-items: center;
            margin-left: 30px;
        }

        .menu-item {
            text-align: center;
            cursor: pointer;
        }

        .coin-balance {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

            .coin-balance img {
                height: 50px;
            }

        .shop-container {
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .voucher-list {
            background-color: #4d4d4d;
            padding: 10px;
            border-radius: 20px;
            width: 250px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .voucher-item {
            background-color: #7a7a7a;
            padding: 15px;
            text-align: center;
            border-radius: 15px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            border: 2px solid transparent;
        }

            .voucher-item.selected {
                border: 2px solid #b8b8ff;
            }

        .voucher-details {
            background-color: #4d4d4d;
            padding: 20px;
            border-radius: 20px;
            flex: 1;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .voucher-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

            .voucher-header span {
                font-size: 1.1em;
            }

        .buy-button {
            background-color: #7a7a7a;
            padding: 10px 20px;
            border: none;
            border-radius: 20px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            align-self: center;
        }

            .buy-button:hover {
                background-color: #999;
            }
    </style>
</head>
<body>
    <main class="shop-container">
        <div class="voucher-list" id="voucherList">
            <div class="voucher-item selected"
                 data-title="Gutschein 10% Kantine"
                 data-time="12:40"
                 data-date="2. Mai 2025">
                Gutschein 10%<br>100 pkt
            </div>
            <div class="voucher-item"
                 data-title="Daurer sei Ehre"
                 data-time="Ganztägig"
                 data-date="Immer gültig">
                Daurer sei Ehre<br>10 pkt
            </div>
        </div>

        <div class="voucher-details" id="voucherDetails">
            <div class="voucher-header">
                <span id="voucherTitle">Gutschein 10% Kantine</span>
                <span id="voucherTime">12:40</span>
                <span id="voucherDate">2. Mai 2025</span>
            </div>
            <button class="buy-button">Gutschein kaufen</button>
        </div>
    </main>

</body>
</html>
