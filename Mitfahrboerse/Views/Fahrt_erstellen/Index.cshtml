@{
    Layout = null;
    int coinBalance = 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>HTL Waidhofen - Mitfahren</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #a5a5a5;
            overflow: hidden;
        }

        header {
            background-color: #cfe2ff;
            display: flex;
            align-items: center;
            padding: 10px 30px;
            justify-content: flex-start;
        }

        .logo {
            display: flex;
            align-items: center;
        }

            .logo img {
                height: 90px;
                margin-right: 10px;
            }

        .menu {
            display: flex;
            gap: 30px;
            align-items: center;
            margin-left: 30px;
        }

        .menu-item {
            text-align: center;
            cursor: pointer;
        }

            .menu-item span {
                display: block;
            }

        .coin-balance {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

            .coin-balance img {
                height: 50px;
            }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <img src="https://upload.wikimedia.org/wikipedia/commons/f/fb/HTL_Waidhofen_Ybbs.png" alt="HTL Logo" />
        </div>
        <div class="menu">
            <div class="menu-item"><span>Mitfahren</span></div>
            <div class="menu-item"><span style="text-decoration: underline;">Fahrt erstellen</span></div>
            <div class="menu-item"><span>Shop</span></div>
            <div class="menu-item"><span>Profil</span></div>
        </div>
        <div class="coin-balance">
            <span>@coinBalance</span>
            <img src="https://images.vexels.com/media/users/3/130116/isolated/preview/215a871596b92451a1678e36960c0ab7-dollar-coin-icon.png" alt="Coins" />
        </div>
    </header>
</body>
</html>